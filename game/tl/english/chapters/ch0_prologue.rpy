# TODO: Translation updated at 2026-07-22 02:09

# game/chapters/ch0_prologue.rpy:12
translate english prologue_f5dbb00b:

    # n "雨从傍晚下到现在，还没有要停的意思。"
    n "The rain has been falling since evening, and it still hasn't decided to stop."

# game/chapters/ch0_prologue.rpy:13
translate english prologue_fd59a5df:

    # n "霓虹灯的光穿过雨幕，在吧台上投下一道道湿漉漉的红。"
    n "Neon light bleeds through the downpour and lays wet streaks of red across the bar."

# game/chapters/ch0_prologue.rpy:14
translate english prologue_307d1409:

    # n "墙上的钟指向凌晨两点四十分。"
    n "The clock on the wall reads 2:40 in the morning."

# game/chapters/ch0_prologue.rpy:16
translate english prologue_025ce5e9:

    # mono "（又是这样一个夜晚。)"
    mono "(Another night like this one.)"

# game/chapters/ch0_prologue.rpy:17
translate english prologue_23b260dd:

    # mono "（我擦着同一只杯子，已经擦了二十分钟。杯子早就干净了，我只是需要一件事来做。)"
    mono "(I've been polishing the same glass for twenty minutes. It's been clean for nineteen of them. I just need something to do with my hands.)"

# game/chapters/ch0_prologue.rpy:19
translate english prologue_97cef3b2:

    # n "这家酒吧叫「Pop's Place」。名字很土，灯光很暗，酒很烈。"
    n "The place is called Pop's. Cheap name, dim lights, strong liquor."

# game/chapters/ch0_prologue.rpy:20
translate english prologue_8c63bdfd:

    # n "来这儿的人，多半不是为了喝酒。"
    n "The people who come here mostly aren't here for the drink."

# game/chapters/ch0_prologue.rpy:22
translate english prologue_3b825e59:

    # mono "（他们是为了找一个愿意听他们说话的人。)"
    mono "(They're here for someone willing to listen.)"

# game/chapters/ch0_prologue.rpy:23
translate english prologue_5e067108:

    # mono "（而我，恰好是个最会听故事的人。)"
    mono "(And I happen to be the best listener there is.)"

# game/chapters/ch0_prologue.rpy:24
translate english prologue_b3a2be50:

    # mono "（……说来奇怪。)"
    mono "(...Strange, though.)"

# game/chapters/ch0_prologue.rpy:25
translate english prologue_e84dc90c:

    # mono "（我总觉得，我好像听过这个故事。很久很久以前，就听过。)"
    mono "(I keep feeling like I've heard this story before. A long, long time ago.)"

# game/chapters/ch0_prologue.rpy:26
translate english prologue_76c9ff16:

    # mono "（可这怎么可能呢。今晚，才是我第一次见到他。)"
    mono "(But how could I have? Tonight is the first time I've ever seen him.)"

# game/chapters/ch0_prologue.rpy:29
translate english prologue_3daa3d4d:

    # n "门被推开时，铃铛响了一声，闷闷的，像是不情愿。"
    n "The door opens and the bell gives one dull ring, reluctant."

# game/chapters/ch0_prologue.rpy:30
translate english prologue_f8eeab60:

    # n "进来的是一个年轻男人。"
    n "A young man comes in."

# game/chapters/ch0_prologue.rpy:36
translate english prologue_24cabc54:

    # n "他大概二十五六岁，瘦削，穿着一件旧得发白的男士衬衫，外面套着夹克。"
    n "Mid-twenties, maybe. Thin, in a men's shirt gone pale with age and a jacket over it."

# game/chapters/ch0_prologue.rpy:37
translate english prologue_6a62a65c:

    # n "头发剪得很短。他在门口站了一会儿，像是在确认这里还有没有别人。"
    n "Hair cropped short. He stands in the doorway a moment, as if checking whether anyone else is here."

# game/chapters/ch0_prologue.rpy:38
translate english prologue_1c0c02d8:

    # n "然后他走到吧台前，坐下。"
    n "Then he walks to the bar and sits down."

# game/chapters/ch0_prologue.rpy:40
translate english prologue_86d1d3df:

    # n "他没有立刻说话。他只是坐着，盯着吧台上一道划痕，仿佛那道划痕里藏着什么答案。"
    n "He doesn't speak right away. He just sits there, staring at a scratch in the counter, as if the answer to something were hidden in it."

# game/chapters/ch0_prologue.rpy:43
translate english prologue_ab1c0b20:

    # mono "（我抬起头，准备问他喝什么。)"
    mono "(I look up to ask him what he'll have.)"

# game/chapters/ch0_prologue.rpy:44
translate english prologue_a70f1f04:

    # mono "（然后我看见了她的——他的眼睛。)"
    mono "(And then I see his — her — his eyes.)"

# game/chapters/ch0_prologue.rpy:48
translate english prologue_7abc0078:

    # mono "（灰绿色的。)"
    mono "(Grey-green.)"

# game/chapters/ch0_prologue.rpy:49
translate english prologue_cd85cea5:

    # mono "（很淡，像冬天结了薄冰的湖面。)"
    mono "(Pale, like a lake skinned with thin ice in winter.)"

# game/chapters/ch0_prologue.rpy:50
translate english prologue_2908362f:

    # mono "（……我在哪里见过这样的眼睛。)"
    mono "(...I've seen eyes like that somewhere.)"

# game/chapters/ch0_prologue.rpy:51
translate english prologue_434376af:

    # mono "（不。不是「见过」。)"
    mono "(No. Not \"seen.\")"

# game/chapters/ch0_prologue.rpy:52
translate english prologue_b06f6373:

    # mono "（是「太熟悉了」。熟悉得让我握着杯子的手顿了一下。)"
    mono "(\"Known.\" Known them so well that my hand tightens on the glass.)"

# game/chapters/ch0_prologue.rpy:56
translate english prologue_b636431f:

    # bart "……" nointeract
    bart "..." nointeract

# game/chapters/ch0_prologue.rpy:60
translate english prologue_ac4f2952:

    # mono "（又一个被生活打败的人。这座城市里多的是。)"
    mono "(Just another one, beaten down by life. This city's full of them.)"

# game/chapters/ch0_prologue.rpy:61
translate english prologue_decfbc61:

    # mono "（他会在天亮前喝醉，讲一些没人想听的事，然后消失。)"
    mono "(He'll get drunk before dawn, tell some story no one wants to hear, and vanish.)"

# game/chapters/ch0_prologue.rpy:65
translate english prologue_641f9546:

    # mono "（他的眼睛……让我想起某个人。)"
    mono "(His eyes... they remind me of someone.)"

# game/chapters/ch0_prologue.rpy:66
translate english prologue_62b80481:

    # mono "（一个我以为再也不会见到的人。)"
    mono "(Someone I thought I'd never see again.)"

# game/chapters/ch0_prologue.rpy:67
translate english prologue_3b0088ae:

    # mono "（可这怎么可能呢。)"
    mono "(But how could that be.)"

# game/chapters/ch0_prologue.rpy:71
translate english prologue_0087fd40:

    # mono "（今晚，我会好好听他说。)"
    mono "(Tonight, I'll listen to him properly.)"

# game/chapters/ch0_prologue.rpy:72
translate english prologue_03c724fa:

    # mono "（不知道为什么，我觉得我应该听。)"
    mono "(I don't know why, but I feel like I should listen.)"

# game/chapters/ch0_prologue.rpy:73
translate english prologue_938ce102:

    # mono "（就好像……我等这一晚，已经等了很久。)"
    mono "(As if... I've been waiting for this night a long, long time.)"

# game/chapters/ch0_prologue.rpy:76
translate english prologue_e8a24ddc:

    # john "威士忌。"
    john "Whiskey."

# game/chapters/ch0_prologue.rpy:77
translate english prologue_9068805f:

    # n "他的声音很低，有点哑，像是很久没跟人说过话了。"
    n "His voice is low, a little hoarse, like he hasn't spoken to anyone in a long while."

# game/chapters/ch0_prologue.rpy:78
translate english prologue_8b4c2af3:

    # john "纯的。别加那些乱七八糟的。"
    john "Neat. None of that nonsense in it."

# game/chapters/ch0_prologue.rpy:80
translate english prologue_8c186e03:

    # bart "好。"
    bart "Sure."

# game/chapters/ch0_prologue.rpy:82
translate english prologue_209ca361:

    # n "我倒了一杯，推过去。"
    n "I pour one and slide it over."

# game/chapters/ch0_prologue.rpy:83
translate english prologue_d30beec5:

    # n "他端起来，没有马上喝。他用两只手捧着杯子，像是在取暖。"
    n "He picks it up but doesn't drink right away. He cradles the glass in both hands, like he's warming them."

# game/chapters/ch0_prologue.rpy:86
translate english prologue_6b2947fb:

    # mono "（他握杯子的方式有点奇怪。)"
    mono "(There's something odd about the way he holds it.)"

# game/chapters/ch0_prologue.rpy:87
translate english prologue_899b79a3:

    # mono "（小指微微翘着，手腕很柔。不像一个男人该有的姿势。)"
    mono "(Pinky slightly out, wrists soft. Not the way a man holds a glass.)"

# game/chapters/ch0_prologue.rpy:88
translate english prologue_7523e8d2:

    # mono "（倒像是……一个习惯了端茶杯的女人。)"
    mono "(More like... a woman used to holding a teacup.)"

# game/chapters/ch0_prologue.rpy:90
translate english prologue_ce1ca2b5:

    # n "他喝了一口，皱了皱眉，又喝了一口。"
    n "He takes a sip, frowns, takes another."

# game/chapters/ch0_prologue.rpy:91
translate english prologue_4a39c30e:

    # n "然后他抬起头，看着我。那双灰绿色的眼睛里，有一种我很熟悉的东西。"
    n "Then he looks up at me. In those grey-green eyes, there's something I know well."

# game/chapters/ch0_prologue.rpy:93
translate english prologue_9da93c6c:

    # john "你不像别的酒保。"
    john "You're not like other bartenders."

# game/chapters/ch0_prologue.rpy:94
translate english prologue_3fc09a68:

    # bart "哦？"
    bart "Oh?"

# game/chapters/ch0_prologue.rpy:95
translate english prologue_7d10b536:

    # john "别的酒保会问『今天过得怎么样』之类的废话。你不问。"
    john "Other bartenders ask 'how's your night' and all that crap. You don't."

# game/chapters/ch0_prologue.rpy:98
translate english prologue_b636431f_1:

    # bart "……" nointeract
    bart "..." nointeract

# game/chapters/ch0_prologue.rpy:103
translate english prologue_4d026005:

    # john "……"
    john "..."

# game/chapters/ch0_prologue.rpy:104
translate english prologue_4b74cde2:

    # n "他愣了一下，然后笑了。那笑容很短，像是脸上的肌肉已经忘记了怎么笑。"
    n "He blinks, then smiles. The smile is short, as if his face has forgotten how."

# game/chapters/ch0_prologue.rpy:105
translate english prologue_54030718:

    # john "是啊。我不想。"
    john "Yeah. I don't."

# game/chapters/ch0_prologue.rpy:110
translate english prologue_b4c2357b:

    # john "等我开口？"
    john "Waiting for me to start?"

# game/chapters/ch0_prologue.rpy:111
translate english prologue_d1f598ee:

    # n "他眯起眼睛，像是在打量我。"
    n "He narrows his eyes, sizing me up."

# game/chapters/ch0_prologue.rpy:112
translate english prologue_4add9c13:

    # john "你倒是自信。你怎么知道我会开口？"
    john "Confident, aren't you. How do you know I'll start?"

# game/chapters/ch0_prologue.rpy:116
translate english prologue_b012eef2:

    # john "哼。"
    john "Hmph."

# game/chapters/ch0_prologue.rpy:117
translate english prologue_7d6a5233:

    # n "他又喝了一口。"
    n "He takes another sip."

# game/chapters/ch0_prologue.rpy:118
translate english prologue_ac7e3146:

    # john "也是。酒保嘛。半个牧师，半个垃圾桶。"
    john "Fair enough. A bartender. Half priest, half trash can."

# game/chapters/ch0_prologue.rpy:121
translate english prologue_08fc68a0:

    # n "他从夹克口袋里掏出一叠皱巴巴的纸，放在吧台上。"
    n "He pulls a wad of crumpled paper from his jacket pocket and lays it on the bar."

# game/chapters/ch0_prologue.rpy:122
translate english prologue_a9f9c5ab:

    # n "我瞥了一眼。是手写的稿子，字迹很密。"
    n "I glance at it. Handwritten manuscript, dense script."

# game/chapters/ch0_prologue.rpy:125
translate english prologue_a9e28e0e:

    # mono "（那字迹……)"
    mono "(That handwriting...)"

# game/chapters/ch0_prologue.rpy:126
translate english prologue_3d4726f3:

    # mono "（我心头又是一跳。)"
    mono "(My heart jumps again.)"

# game/chapters/ch0_prologue.rpy:127
translate english prologue_c1a8462d:

    # mono "（那字迹，和我自己的，几乎一模一样。)"
    mono "(It's almost exactly like my own.)"

# game/chapters/ch0_prologue.rpy:128
translate english prologue_92257f76:

    # mono "（一定是我看错了。这种巧合……太荒唐了。)"
    mono "(I must be seeing things. A coincidence like that... absurd.)"

# game/chapters/ch0_prologue.rpy:130
translate english prologue_9e44269b:

    # john "你看过《真话杂志》吗？"
    john "You ever read True Confessions?"

# game/chapters/ch0_prologue.rpy:131
translate english prologue_ba6b0e79:

    # bart "偶尔翻翻。"
    bart "Now and then."

# game/chapters/ch0_prologue.rpy:132
translate english prologue_4c0b10d7:

    # john "上面有个专栏，叫『未婚妈妈』。专门登那些……私生子的母亲写的忏悔故事。"
    john "There's a column in it. 'The Unmarried Mother.' All those stories — women who had a baby out of wedlock, writing their little confessions."

# game/chapters/ch0_prologue.rpy:133
translate english prologue_b12ba826:

    # n "他扯了扯嘴角，那不算笑。"
    n "The corner of his mouth twitches. It isn't a smile."

# game/chapters/ch0_prologue.rpy:134
translate english prologue_dfd29772:

    # john "那些故事，都是我写的。"
    john "I write every one of them."

# game/chapters/ch0_prologue.rpy:137
translate english prologue_b636431f_2:

    # bart "……" nointeract
    bart "..." nointeract

# game/chapters/ch0_prologue.rpy:141
translate english prologue_aca288ba:

    # john "假扮？"
    john "Pretend?"

# game/chapters/ch0_prologue.rpy:142
translate english prologue_7771d913:

    # n "他的眼神突然变得很锋利。"
    n "His eyes go sharp, all at once."

# game/chapters/ch0_prologue.rpy:143
translate english prologue_6e978db6:

    # john "我不用假扮。我比那些女人更懂她们写的每一个字。"
    john "I don't have to pretend. I understand every word those women write better than they do."

# game/chapters/ch0_prologue.rpy:144
translate english prologue_d9a8501e:

    # john "因为那些事……我都经历过。"
    john "Because those things... I've lived them all."

# game/chapters/ch0_prologue.rpy:148
translate english prologue_946d1b4b:

    # john "赚钱？"
    john "Pay well?"

# game/chapters/ch0_prologue.rpy:149
translate english prologue_705c4b33:

    # n "他冷笑了一声。"
    n "He gives a cold little laugh."

# game/chapters/ch0_prologue.rpy:150
translate english prologue_9af354c0:

    # john "一个字半分钱。我写一个母亲怎样被男人抛弃、怎样独自生下孩子、怎样在深夜里哭——"
    john "Half a cent a word. I write about a mother abandoned by her man, having her baby alone, crying in the middle of the night —"

# game/chapters/ch0_prologue.rpy:151
translate english prologue_58d47fbf:

    # john "——半分钱。"
    john "— half a cent."

# game/chapters/ch0_prologue.rpy:152
translate english prologue_51d9e785:

    # john "我把我的命，一个字半分钱地卖给他们。"
    john "I sell my life to them, half a cent a word."

# game/chapters/ch0_prologue.rpy:157
translate english prologue_984af3f1:

    # n "他看着我，似乎想从我脸上找出嘲讽。但他没找到。"
    n "He looks at me, searching my face for mockery. He doesn't find any."

# game/chapters/ch0_prologue.rpy:158
translate english prologue_f38b0c53:

    # john "……你怎么知道写得好？你看过？"
    john "...How do you know they're good? You've read them?"

# game/chapters/ch0_prologue.rpy:159
translate english prologue_63bdf4a3:

    # bart "我看过几篇。"
    bart "I've read a few."

# game/chapters/ch0_prologue.rpy:160
translate english prologue_07b90eeb:

    # bart "写那些故事的人，一定受过很深的伤。"
    bart "Whoever writes those stories must have been hurt, badly."

# game/chapters/ch0_prologue.rpy:161
translate english prologue_2448926b:

    # n "他沉默了很久。久到我以为他不会回答了。"
    n "He's quiet for a long time. So long I think he won't answer."

# game/chapters/ch0_prologue.rpy:162
translate english prologue_6959d3d5:

    # john "……是啊。"
    john "...Yeah."

# game/chapters/ch0_prologue.rpy:163
translate english prologue_87ae8427:

    # john "受过很深的伤。"
    john "Hurt badly."

# game/chapters/ch0_prologue.rpy:166
translate english prologue_02e8d2ea:

    # n "他又喝了一大口。杯子快空了。"
    n "He takes another long pull. The glass is nearly empty."

# game/chapters/ch0_prologue.rpy:167
translate english prologue_c4fcf1f2:

    # n "雨还在下。钟指向三点。"
    n "The rain keeps on. The clock hits three."

# game/chapters/ch0_prologue.rpy:168
translate english prologue_d819807a:

    # n "我知道，他快要说了。那些他憋了很久、没人可说的话。"
    n "I know he's about to say it. The things he's held in so long, with no one to tell."

# game/chapters/ch0_prologue.rpy:170
translate english prologue_8d85d3bb:

    # mono "（说吧。)"
    mono "(Go on, then.)"

# game/chapters/ch0_prologue.rpy:171
translate english prologue_853bb6e3:

    # mono "（告诉我，你是怎么变成现在这个样子的。)"
    mono "(Tell me how you became this.)"

# game/chapters/ch0_prologue.rpy:172
translate english prologue_0e380104:

    # mono "（告诉我……这一切，到底是从哪里开始的。)"
    mono "(Tell me... where any of it even began.)"

# game/chapters/ch0_prologue.rpy:174
translate english prologue_726f0140:

    # john "你真的很想听？"
    john "You really want to hear it?"

# game/chapters/ch0_prologue.rpy:175
translate english prologue_9dd9198e:

    # john "我这一生，说出来都没人信。"
    john "My life — nobody'd believe it if I told them."

# game/chapters/ch0_prologue.rpy:178
translate english prologue_b636431f_3:

    # bart "……" nointeract
    bart "..." nointeract

# game/chapters/ch0_prologue.rpy:182
translate english prologue_d792d8b8:

    # john "哈。"
    john "Ha."

# game/chapters/ch0_prologue.rpy:183
translate english prologue_08af5d86:

    # n "他把空杯子推向我。"
    n "He pushes the empty glass toward me."

# game/chapters/ch0_prologue.rpy:184
translate english prologue_8cfe27d0:

    # john "再来一杯。然后我告诉你。"
    john "Another one. Then I'll tell you."

# game/chapters/ch0_prologue.rpy:185
translate english prologue_161851d5:

    # john "从头开始。从那个该死的孤儿院开始。"
    john "From the start. From that goddamn orphanage."

# game/chapters/ch0_prologue.rpy:189
translate english prologue_c694052c:

    # n "我拿起酒瓶，给他续上。"
    n "I pick up the bottle and refill his glass."

# game/chapters/ch0_prologue.rpy:190
translate english prologue_79251e32:

    # john "……行。"
    john "...Fine."

# game/chapters/ch0_prologue.rpy:191
translate english prologue_0895f7d9:

    # n "他深吸一口气，像是在跳进什么冰冷的东西里。"
    n "He takes a deep breath, like he's jumping into something cold."

# game/chapters/ch0_prologue.rpy:192
translate english prologue_dd14048a:

    # john "那就从1945年说起吧。"
    john "Then let's start with 1945."

# game/chapters/ch0_prologue.rpy:194
translate english prologue_8c11d64f:

    # n "我又给他倒了一杯。"
    n "I pour him another."

# game/chapters/ch0_prologue.rpy:195
translate english prologue_f514b906:

    # n "他端着杯子，目光越过我，看向某个很远的地方。"
    n "He holds the glass and looks past me, at somewhere far away."

# game/chapters/ch0_prologue.rpy:196
translate english prologue_34f15f4a:

    # n "某个回不去的地方。"
    n "Somewhere he can't get back to."

