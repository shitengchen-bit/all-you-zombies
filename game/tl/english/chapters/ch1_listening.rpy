# game/chapters/ch1_listening.rpy:17
translate english act1_hub_72c22c5a:

    # mono "（时钟滴答。雨声不断。)"
    mono "(The clock ticks. The rain keeps on.)"

# game/chapters/ch1_listening.rpy:18
translate english act1_hub_464372d7:

    # mono "（他坐在我面前，像一本被雨水泡皱的书。)"
    mono "(He sits across from me, like a book warped by rain.)"

# game/chapters/ch1_listening.rpy:19
translate english act1_hub_dacbc92e:

    # mono "（而我，可以翻开任何一页。)"
    mono "(And I can turn to any page.)"

# game/chapters/ch1_listening.rpy:22
translate english act1_hub_03f02150:

    # n "你想从哪里问起？" nointeract
    n "Where do you want to start?" nointeract

# game/chapters/ch1_listening.rpy:41
translate english act1_hub_6d63a365:

    # mono "（有些时候，不问，比问更有用。)"
    mono "(Sometimes not asking is more useful than asking.)"

# game/chapters/ch1_listening.rpy:42
translate english act1_hub_a0bfee7e:

    # n "我给他续了酒。他看了我一眼，那眼神软了一瞬。"
    n "I refill his glass. He glances at me, and for an instant his gaze softens."

# game/chapters/ch1_listening.rpy:55
translate english topic_childhood_d6006827:

    # john "童年。"
    john "Childhood."

# game/chapters/ch1_listening.rpy:56
translate english topic_childhood_7ed6de42:

    # n "他重复了一遍这个词，像是在嚼一块石头。"
    n "He repeats the word like he's chewing on a stone."

# game/chapters/ch1_listening.rpy:57
translate english topic_childhood_612212c4:

    # john "我的童年，得从一扇门外说起。"
    john "Mine starts outside a door."

# game/chapters/ch1_listening.rpy:62
translate english topic_childhood_7c1aae71:

    # mono "（他的声音低下去。酒吧的灯光，仿佛也跟着暗了。)"
    mono "(His voice drops. The bar's lights seem to dim with it.)"

# game/chapters/ch1_listening.rpy:63
translate english topic_childhood_8a8a5b46:

    # mono "（然后，我看见了那扇门。)"
    mono "(And then I see that door.)"

# game/chapters/ch1_listening.rpy:70
translate english topic_childhood_d376d656:

    # n "1945年。克利夫兰。冬天。"
    n "1945. Cleveland. Winter."

# game/chapters/ch1_listening.rpy:71
translate english topic_childhood_665954f0:

    # n "雪下得很大。一家孤儿院的铁门，锈迹斑斑。"
    n "The snow is coming down hard. The iron gate of an orphanage, rusted through."

# game/chapters/ch1_listening.rpy:76
translate english topic_childhood_6755e7ac:

    # n "一个包裹被放在台阶上。包裹里是一个婴儿。"
    n "A bundle is set down on the steps. Inside the bundle is a baby."

# game/chapters/ch1_listening.rpy:77
translate english topic_childhood_3e14bd0b:

    # n "没有字条。没有名字。"
    n "No note. No name."

# game/chapters/ch1_listening.rpy:78
translate english topic_childhood_6926b31b:

    # n "只有襁褓里，一张冻得发紫的小脸。"
    n "Just a small face, purple with cold, inside the swaddling."

# game/chapters/ch1_listening.rpy:82
translate english topic_childhood_b84a3bdf:

    # mono "（修女把婴儿抱起来的时候，我注意到——)"
    mono "(When the nun lifts the baby, I notice —)"

# game/chapters/ch1_listening.rpy:83
translate english topic_childhood_bf62b1f9:

    # mono "（她的左眉尾，有一道极细的胎记。淡得几乎看不见。)"
    mono "(At the tail of her left eyebrow, the faintest birthmark. So pale you'd miss it.)"

# game/chapters/ch1_listening.rpy:84
translate english topic_childhood_72879ebc:

    # mono "（……和我的，一模一样。)"
    mono "(...Exactly like mine.)"

# game/chapters/ch1_listening.rpy:89
translate english topic_childhood_c358d61e:

    # n "他们给她起名叫简。"
    n "They name her Jane."

# game/chapters/ch1_listening.rpy:90
translate english topic_childhood_d9d21515:

    # n "简在孤儿院里长大。她很聪明，聪明得不像话。"
    n "Jane grows up in the orphanage. She's clever — absurdly clever."

# game/chapters/ch1_listening.rpy:91
translate english topic_childhood_9822e521:

    # n "但她也怪。怪得让别的孩子躲着她，让修女们摇头。"
    n "But she's strange, too. Strange enough that the other children avoid her and the nuns shake their heads."

# game/chapters/ch1_listening.rpy:93
translate english topic_childhood_f76d1193:

    # jane "为什么我和别人不一样？"
    jane "Why am I different from everyone else?"

# game/chapters/ch1_listening.rpy:94
translate english topic_childhood_33a912a5:

    # n "七岁的简问修女。修女没有回答。"
    n "Seven-year-old Jane asks a nun. The nun doesn't answer."

# game/chapters/ch1_listening.rpy:96
translate english topic_childhood_cb409625:

    # jane "我没有爸爸，也没有妈妈。我连自己从哪里来都不知道。"
    jane "I don't have a father, or a mother either. I don't even know where I came from."

# game/chapters/ch1_listening.rpy:97
translate english topic_childhood_96bf8fd3:

    # n "她站在窗前，看着外面的雪。"
    n "She stands at the window, watching the snow."

# game/chapters/ch1_listening.rpy:98
translate english topic_childhood_85b47081:

    # jane "我是不是……捡来的？"
    jane "Was I... picked up off the street?"

# game/chapters/ch1_listening.rpy:100
translate english topic_childhood_9835d169:

    # mono "（不知道为什么，看着那扇铁门，看着雪里那个小小的包裹——)"
    mono "(I don't know why, but looking at that iron gate, at that small bundle in the snow —)"

# game/chapters/ch1_listening.rpy:101
translate english topic_childhood_4a48bcf0:

    # mono "（我的心口，闷闷地疼。)"
    mono "(My chest aches, dully.)"

# game/chapters/ch1_listening.rpy:102
translate english topic_childhood_8c3e18a9:

    # mono "（像是我来过这里。像是……我欠了这里，一笔还不清的债。)"
    mono "(Like I've been here before. Like... I owe this place a debt I can never repay.)"

# game/chapters/ch1_listening.rpy:104
translate english topic_childhood_32118894:

    # n "简十岁那年，第一次发现自己和别人「不一样」。"
    n "When Jane is ten, she first discovers she's \"different.\""

# game/chapters/ch1_listening.rpy:105
translate english topic_childhood_0a9dc86a:

    # n "她的身体里，有一些……说不清楚的东西。"
    n "There's something about her body she can't quite name."

# game/chapters/ch1_listening.rpy:106
translate english topic_childhood_6f2580d2:

    # n "她不敢告诉任何人。她只是更加沉默，更加格格不入。"
    n "She doesn't dare tell anyone. She just goes quieter, more apart."

# game/chapters/ch1_listening.rpy:108
translate english topic_childhood_97bdfeda:

    # jane "（我一定是什么地方坏了。)"
    jane "(There must be something broken in me.)"

# game/chapters/ch1_listening.rpy:109
translate english topic_childhood_5c6083cc:

    # jane "（所以才会被扔掉。)"
    jane "(That's why they threw me away.)"

# game/chapters/ch1_listening.rpy:116
translate english topic_childhood_3b1facce:

    # john "她从小就觉得，自己是坏的。"
    john "She grew up believing she was broken."

# game/chapters/ch1_listening.rpy:117
translate english topic_childhood_c5d19b43:

    # john "被扔掉的东西，肯定是坏的。她一直是这么想的。"
    john "Anything thrown away must be broken. She always thought that."

# game/chapters/ch1_listening.rpy:120
translate english topic_childhood_b636431f:

    # bart "……" nointeract
    bart "..." nointeract

# game/chapters/ch1_listening.rpy:124
translate english topic_childhood_8c087fa4:

    # john "狠心？"
    john "Cruel?"

# game/chapters/ch1_listening.rpy:125
translate english topic_childhood_69327c25:

    # n "他冷笑。"
    n "He gives a cold laugh."

# game/chapters/ch1_listening.rpy:126
translate english topic_childhood_56377588:

    # john "也许吧。但你知道吗，我后来想过——"
    john "Maybe. But you know, I've thought about it since —"

# game/chapters/ch1_listening.rpy:127
translate english topic_childhood_00512b7c:

    # john "也许把她放在那儿的人，是唯一一个……知道该把她放在哪儿的人。"
    john "Maybe the person who left her there was the only one... who knew where she ought to be left."

# game/chapters/ch1_listening.rpy:132
translate english topic_childhood_2c048b04:

    # john "命运。"
    john "Fate."

# game/chapters/ch1_listening.rpy:133
translate english topic_childhood_eba4ba1e:

    # n "他盯着酒杯里晃动的琥珀色。"
    n "He stares at the amber swirling in his glass."

# game/chapters/ch1_listening.rpy:134
translate english topic_childhood_00bcb0b1:

    # john "你信命运？"
    john "Do you believe in fate?"

# game/chapters/ch1_listening.rpy:135
translate english topic_childhood_fdba1408:

    # john "我从前不信。现在……我不知道了。"
    john "I didn't used to. Now... I don't know."

# game/chapters/ch1_listening.rpy:140
translate english topic_childhood_c645eb32:

    # n "他抬起头，看着我。那双灰绿色的眼睛，颤了一下。"
    n "He looks up at me. Those grey-green eyes tremble, just once."

# game/chapters/ch1_listening.rpy:141
translate english topic_childhood_a81bfdcc:

    # john "……与众不同。"
    john "...Different."

# game/chapters/ch1_listening.rpy:142
translate english topic_childhood_0132b670:

    # john "你是第一个，没用「怪」这个字的人。"
    john "You're the first person who didn't use the word 'strange.'"

# game/chapters/ch1_listening.rpy:157
translate english topic_love_b248d46f:

    # john "爱。"
    john "Love."

# game/chapters/ch1_listening.rpy:158
translate english topic_love_869cf83e:

    # n "他说这个字的时候，声音轻得像是怕惊动什么。"
    n "He says the word so softly it's almost afraid to wake something."

# game/chapters/ch1_listening.rpy:159
translate english topic_love_988b95ca:

    # john "我这一生，只爱过一次。"
    john "I only ever loved once in my life."

# game/chapters/ch1_listening.rpy:160
translate english topic_love_48a83e32:

    # john "就那么一次。"
    john "Just the once."

# game/chapters/ch1_listening.rpy:164
translate english topic_love_4b7a6cd7:

    # mono "（他闭上了眼睛。)"
    mono "(He closes his eyes.)"

# game/chapters/ch1_listening.rpy:165
translate english topic_love_249e61e4:

    # mono "（于是，1963年的春天，来了。)"
    mono "(And so the spring of 1963 arrives.)"

# game/chapters/ch1_listening.rpy:172
translate english topic_love_24b1c7ff:

    # n "1963年。四月。公园里的樱花开了。"
    n "1963. April. The cherry blossoms are out in the park."

# game/chapters/ch1_listening.rpy:173
translate english topic_love_1634b62f:

    # n "阳光从花瓣的缝隙里漏下来，碎成一地金子。"
    n "Sunlight leaks through the petals and shatters into a thousand gold coins on the ground."

# game/chapters/ch1_listening.rpy:175
translate english topic_love_e77c80a6:

    # n "简十八岁了。她坐在长椅上，膝盖上摊着一本书，但她没在看。"
    n "Jane is eighteen. She sits on a bench with a book open on her knee, but she isn't reading."

# game/chapters/ch1_listening.rpy:176
translate english topic_love_46dd3973:

    # n "她在看人来人往，心里想：没有一个人，是为我而来的。"
    n "She's watching people come and go, thinking: not one of them is here for me."

# game/chapters/ch1_listening.rpy:178
translate english topic_love_ea0b7890:

    # n "然后，一个男人在她身边坐下了。"
    n "Then a man sits down beside her."

# game/chapters/ch1_listening.rpy:183
translate english topic_love_041b9c70:

    # n "他看起来很普通。但简一抬头，就愣住了。"
    n "He looks ordinary enough. But the moment Jane looks up, she freezes."

# game/chapters/ch1_listening.rpy:184
translate english topic_love_144e10ad:

    # n "因为那个男人，正用一种她从未见过的眼神看着她。"
    n "Because the man is looking at her in a way no one ever has."

# game/chapters/ch1_listening.rpy:185
translate english topic_love_a5a95e77:

    # n "像是……认识她。认识了一辈子。"
    n "As if he knows her. Has known her all his life."

# game/chapters/ch1_listening.rpy:187
translate english topic_love_eb5f31e8:

    # stranger "你在看人。"
    stranger "You're watching people."

# game/chapters/ch1_listening.rpy:188
translate english topic_love_222a2f5f:

    # jane "……什么？"
    jane "...What?"

# game/chapters/ch1_listening.rpy:189
translate english topic_love_3e3ccf75:

    # stranger "你坐在这儿，看人来人往。你在想——没有一个人是为我而来的。"
    stranger "You sit here watching them come and go. You're thinking — not one of them is here for me."

# game/chapters/ch1_listening.rpy:190
translate english topic_love_621ee8f1:

    # n "简的书从膝盖上滑下去了。"
    n "The book slides off Jane's knee."

# game/chapters/ch1_listening.rpy:191
translate english topic_love_f203a682:

    # jane "你……你怎么知道我在想什么？"
    jane "How... how did you know what I was thinking?"

# game/chapters/ch1_listening.rpy:192
translate english topic_love_6fa4adac:

    # stranger "因为我也这么想过。"
    stranger "Because I've thought it too."

# game/chapters/ch1_listening.rpy:193
translate english topic_love_372a5e6c:

    # n "他笑了。"
    n "He smiles."

# game/chapters/ch1_listening.rpy:194
translate english topic_love_eb199671:

    # stranger "很多年，每一天，都这么想。"
    stranger "For years. Every single day."

# game/chapters/ch1_listening.rpy:198
translate english topic_love_32d9100b:

    # mono "（他们聊了很久。)"
    mono "(They talk for a long time.)"

# game/chapters/ch1_listening.rpy:199
translate english topic_love_7f0d8e95:

    # mono "（简说，那个男人买了一杯热可可，握杯子的姿势很奇怪——)"
    mono "(Jane says the man bought a hot cocoa and held the cup strangely —)"

# game/chapters/ch1_listening.rpy:200
translate english topic_love_5a6d7d23:

    # mono "（小指微翘，手腕很柔。)"
    mono "(Pinky out, wrists soft.)"

# game/chapters/ch1_listening.rpy:201
translate english topic_love_acfd8d87:

    # mono "（「和我一模一样。」她说。)"
    mono "(\"Just like me,\" she says.)"

# game/chapters/ch1_listening.rpy:202
translate english topic_love_c0f3d22f:

    # mono "（「我从来没见过别人那样拿杯子。」)"
    mono "(\"I've never seen anyone hold a cup that way before.\")"

# game/chapters/ch1_listening.rpy:204
translate english topic_love_5d726ada:

    # n "那是简第一次，遇到一个「懂」她的人。"
    n "It's the first time Jane has ever met someone who \"gets\" her."

# game/chapters/ch1_listening.rpy:205
translate english topic_love_40a04dc8:

    # n "他说出的每一句话，都像是从她心里抄出来的。"
    n "Every word he says is like it was copied out of her own heart."

# game/chapters/ch1_listening.rpy:206
translate english topic_love_7eb575b3:

    # n "她的孤独，她的格格不入，她身体里那个说不清楚的秘密——"
    n "Her loneliness, her not fitting in, the secret in her body she can't name —"

# game/chapters/ch1_listening.rpy:207
translate english topic_love_a782f209:

    # n "他全都知道。全都能接住。"
    n "He knows it all. Can hold it all."

# game/chapters/ch1_listening.rpy:209
translate english topic_love_67df5da6:

    # jane "为什么……你好像什么都懂我？"
    jane "Why... why do you seem to understand me so completely?"

# game/chapters/ch1_listening.rpy:210
translate english topic_love_fd64425b:

    # stranger "因为我们是同一类人。"
    stranger "Because we're the same kind of person."

# game/chapters/ch1_listening.rpy:211
translate english topic_love_54407fae:

    # n "他说这句话的时候，看着她的眼睛。"
    n "He says it looking into her eyes."

# game/chapters/ch1_listening.rpy:212
translate english topic_love_c32fa093:

    # stranger "这世上，再没有第二个人，比我更懂你。"
    stranger "There's no one else in this world who understands you the way I do."

# game/chapters/ch1_listening.rpy:217
translate english topic_love_72496591:

    # n "樱花落下来的时候，他吻了她。"
    n "When the blossoms fall, he kisses her."

# game/chapters/ch1_listening.rpy:218
translate english topic_love_4831dbe9:

    # n "那是简十八年的人生里，第一次，感觉到自己不是坏的。"
    n "It's the first time in eighteen years that Jane has felt she isn't broken."

# game/chapters/ch1_listening.rpy:219
translate english topic_love_fcb50179:

    # n "第一次，感觉到——原来我，也是可以被人这样温柔对待的。"
    n "The first time she's felt — that she, too, could be treated this gently."

# game/chapters/ch1_listening.rpy:221
translate english topic_love_00202015:

    # jane "（原来我不是坏的。)"
    jane "(So I'm not broken.)"

# game/chapters/ch1_listening.rpy:222
translate english topic_love_94bb34cc:

    # jane "（原来我，也是可以被爱的。)"
    jane "(So I can be loved, after all.)"

# game/chapters/ch1_listening.rpy:224
translate english topic_love_22a56994:

    # mono "（奇怪。明明是在听别人的故事。)"
    mono "(Strange. I'm only listening to someone else's story.)"

# game/chapters/ch1_listening.rpy:225
translate english topic_love_3f7a9396:

    # mono "（可我的心口，为什么会这么疼？)"
    mono "(So why does my chest ache like this?)"

# game/chapters/ch1_listening.rpy:226
translate english topic_love_76a7dc84:

    # mono "（刚才有一瞬间，我差点脱口而出——「那是我一生中最幸福的一天」。)"
    mono "(For a second I nearly said it out loud — \"that was the happiest day of my life.\")"

# game/chapters/ch1_listening.rpy:227
translate english topic_love_2fb9ca74:

    # mono "（……我怎么会这么想？我又不认识她。)"
    mono "(...Why would I think that? I don't even know her.)"

# game/chapters/ch1_listening.rpy:234
translate english topic_love_ec576521:

    # n "他讲到这里，停住了。他的手指无意识地摩挲着杯沿。"
    n "He stops there. His fingers trace the rim of the glass, absently."

# game/chapters/ch1_listening.rpy:235
translate english topic_love_093a2b21:

    # john "那是我这辈子，唯一一次觉得……自己是完整的。"
    john "That was the only time in my life I ever felt... whole."

# game/chapters/ch1_listening.rpy:238
translate english topic_love_b636431f:

    # bart "……" nointeract
    bart "..." nointeract

# game/chapters/ch1_listening.rpy:242
translate english topic_love_88390e5e:

    # n "这句话脱口而出。说完，我自己都愣了一下。"
    n "The words slip out. Once they're out, I'm startled myself."

# game/chapters/ch1_listening.rpy:243
translate english topic_love_a1e2d1a9:

    # john "……你怎么会懂？"
    john "...How could you understand?"

# game/chapters/ch1_listening.rpy:244
translate english topic_love_430732e7:

    # mono "（因为那就是我。)"
    mono "(Because that was me.)"

# game/chapters/ch1_listening.rpy:245
translate english topic_love_44ab8e0f:

    # mono "（不。不能说。)"
    mono "(No. I can't say it.)"

# game/chapters/ch1_listening.rpy:246
translate english topic_love_49ec3c05:

    # bart "……直觉。"
    bart "...Intuition."

# game/chapters/ch1_listening.rpy:250
translate english topic_love_4c370dca:

    # mono "（我看着他。看着这个还不知道一切的他。)"
    mono "(I look at him. At this version of him who doesn't know yet.)"

# game/chapters/ch1_listening.rpy:251
translate english topic_love_995f1989:

    # mono "（心痛得像被那只杯子砸了一下。)"
    mono "(My heart aches as if that glass had been smashed against it.)"

# game/chapters/ch1_listening.rpy:252
translate english topic_love_a71f14a5:

    # bart "……那一定很美好。"
    bart "...That must have been beautiful."

# game/chapters/ch1_listening.rpy:256
translate english topic_love_ad13cc8a:

    # n "他的脸，一下子暗了下去。"
    n "His face darkens, all at once."

# game/chapters/ch1_listening.rpy:257
translate english topic_love_33d731bc:

    # john "……他？"
    john "...Him?"

# game/chapters/ch1_listening.rpy:258
translate english topic_love_aef90e0f:

    # john "他消失了。"
    john "He disappeared."

# game/chapters/ch1_listening.rpy:273
translate english topic_betrayal_c924ca75:

    # john "你问，他怎么了。"
    john "You ask what happened to him."

# game/chapters/ch1_listening.rpy:274
