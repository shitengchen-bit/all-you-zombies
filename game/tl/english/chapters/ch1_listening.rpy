# game/chapters/ch1_listening.rpy:508
translate english topic_drift_419a79ed:

    # n "他握笔的手，停住了。"
    n "His writing hand goes still."

# game/chapters/ch1_listening.rpy:509
translate english topic_drift_4d026005:

    # john "……"
    john "..."

# game/chapters/ch1_listening.rpy:510
translate english topic_drift_7130b395:

    # john "也许吧。"
    john "Maybe."

# game/chapters/ch1_listening.rpy:511
translate english topic_drift_55e2e5dd:

    # john "也许「未婚妈妈」，从来就不是一个笔名。"
    john "Maybe 'The Unmarried Mother' was never a pen name."

# game/chapters/ch1_listening.rpy:512
translate english topic_drift_c268a298:

    # john "是我给她的……一座坟。"
    john "It was a gravestone I built... for her."

# game/chapters/ch1_listening.rpy:516
translate english topic_drift_eb060de7:

    # john "至少我还能写。"
    john "At least I can still write."

# game/chapters/ch1_listening.rpy:517
translate english topic_drift_f5d2f6a3:

    # n "他重复了一遍，点点头。"
    n "He repeats it, nodding."

# game/chapters/ch1_listening.rpy:518
translate english topic_drift_b7036c2d:

    # john "是啊。至少，我还能把她们的话说出来。"
    john "Yeah. At least I can still say their words."

# game/chapters/ch1_listening.rpy:519
translate english topic_drift_4fbcf698:

    # john "替她们，也替我自己。"
    john "For them, and for myself."

# game/chapters/ch1_listening.rpy:523
translate english topic_drift_afe74f4e:

    # john "配不上？"
    john "Not worthy?"

# game/chapters/ch1_listening.rpy:524
translate english topic_drift_71c23980:

    # n "他把稿子收起来，动作很重。"
    n "He gathers the manuscript, heavily."

# game/chapters/ch1_listening.rpy:525
translate english topic_drift_d2e2652d:

    # john "这世道，连「我」这种东西，都容不下。"
    john "This world can't even make room for a thing like 'me.'"

# game/chapters/ch1_listening.rpy:526
translate english topic_drift_15e2f17c:

    # john "它凭什么，配得上别的。"
    john "What right does it have to be worthy of anything else."

# game/chapters/ch1_listening.rpy:528
translate english topic_drift_ad8b584e:

    # n "他喝完了最后一口酒。"
    n "He finishes the last of his drink."

# game/chapters/ch1_listening.rpy:529
translate english topic_drift_f32161d4:

    # n "杯底朝天。"
    n "The glass tips up, empty."

# game/chapters/ch1_listening.rpy:530
translate english topic_drift_a955d094:

    # john "这就是我了，酒保。"
    john "So that's me, bartender."

# game/chapters/ch1_listening.rpy:531
translate english topic_drift_b146df22:

    # john "一个孤儿，一个骗子的情人，一个被偷走孩子的母亲，一个莫名其妙的男人。"
    john "An orphan. A liar's lover. A mother who had her baby stolen. A man who makes no sense."

# game/chapters/ch1_listening.rpy:532
translate english topic_drift_973753cd:

    # john "一个……写别人忏悔的骗子。"
    john "A... fraud who writes other people's confessions."

# game/chapters/ch1_listening.rpy:534
translate english topic_drift_7139b69a:

    # mono "（不。)"
    mono "(No.)"

# game/chapters/ch1_listening.rpy:535
translate english topic_drift_c35ff5b1:

    # mono "（你不是骗子。)"
    mono "(You're no fraud.)"

# game/chapters/ch1_listening.rpy:536
translate english topic_drift_0d46ade8:

    # mono "（你是这个世界上最诚实的人。)"
    mono "(You're the most honest person alive.)"

# game/chapters/ch1_listening.rpy:537
translate english topic_drift_f8e48603:

    # mono "（因为你的整个人生，就是一个真相。)"
    mono "(Because your whole life is one single truth.)"

# game/chapters/ch1_listening.rpy:538
translate english topic_drift_aa831e57:

    # mono "（一个，你即将亲眼看见的真相。)"
    mono "(One you're about to see with your own eyes.)"

translate english strings:

    # game/chapters/ch1_listening.rpy:24
    old "「说说你的童年吧。」"
    new "\"Tell me about your childhood.\""

    # game/chapters/ch1_listening.rpy:27
    old "「你爱过什么人吗？」"
    new "\"Have you ever loved anyone?\""

    # game/chapters/ch1_listening.rpy:30
    old "「后来呢？那个人。」"
    new "\"And then? That person.\""

    # game/chapters/ch1_listening.rpy:33
    old "「医院里……发生了什么？」"
    new "\"What happened... at the hospital?\""

    # game/chapters/ch1_listening.rpy:36
    old "「这些年，你是怎么过的？」"
    new "\"How have you lived all these years?\""

    # game/chapters/ch1_listening.rpy:39
    old "「……」（给他续一杯酒，不问）"
    new "\"...\" (Refill his glass, ask nothing)"

    # game/chapters/ch1_listening.rpy:122
    old "「谁这么狠心，把一个婴儿扔在雪地里。」"
    new "\"Who could be so cruel, leaving a baby in the snow.\""

    # game/chapters/ch1_listening.rpy:129
    old "「也许，那是命运的安排。」"
    new "\"Maybe it was meant to be.\""

    # game/chapters/ch1_listening.rpy:137
    old "「她不是坏的。她只是……与众不同。」"
    new "\"She wasn't broken. She was just... different.\""

    # game/chapters/ch1_listening.rpy:240
    old "「我比谁都懂那种感觉。」"
    new "\"I understand that better than anyone.\""

    # game/chapters/ch1_listening.rpy:248
    old "（为他感到心痛）"
    new "(Feel the ache for him)"

    # game/chapters/ch1_listening.rpy:254
    old "「然后呢？他怎么了？」"
    new "\"And then? What happened to him?\""

    # game/chapters/ch1_listening.rpy:324
    old "「那个男人该死。」"
    new "\"That man deserves to die.\""

    # game/chapters/ch1_listening.rpy:333
    old "「他真的……懂你吗？」"
    new "\"Did he really... understand you?\""

    # game/chapters/ch1_listening.rpy:342
    old "「你恨他吗？」"
    new "\"Do you hate him?\""

    # game/chapters/ch1_listening.rpy:453
    old "「他们怎么能这样对你。」"
    new "\"How could they do that to you.\""

    # game/chapters/ch1_listening.rpy:460
    old "「你终于，成为了你自己。」"
    new "\"You finally became yourself.\""

    # game/chapters/ch1_listening.rpy:468
    old "「她还在。她一直都在。」"
    new "\"She's still there. She always has been.\""

    # game/chapters/ch1_listening.rpy:505
    old "「你写的是她。你身体里的那个她。」"
    new "\"You're writing her. The one inside you.\""

    # game/chapters/ch1_listening.rpy:514
    old "「至少，你还能写。」"
    new "\"At least you can still write.\""

    # game/chapters/ch1_listening.rpy:521
    old "「这世道，配不上你写的东西。」"
    new "\"This world isn't worthy of what you write.\""
