# game/chapters/ch3_jump.rpy:11
translate english act3_jump_ed173ecb:

    # n "这里不是任何地方。"
    n "This is nowhere."

# game/chapters/ch3_jump.rpy:12
translate english act3_jump_73020d5c:

    # n "这里是「之间」。"
    n "This is \"between.\""

# game/chapters/ch3_jump.rpy:14
translate english act3_jump_e9654cf8:

    # n "琥珀色的光，拧成一股一股的漩涡，向深处旋转。"
    n "Amber light twists into spirals, turning down into the deep."

# game/chapters/ch3_jump.rpy:15
translate english act3_jump_a8515df1:

    # n "深蓝，焦赭，一圈一圈，像一条咬住自己尾巴的蛇。"
    n "Indigo, burnt sienna, ring after ring — like a snake swallowing its own tail."

# game/chapters/ch3_jump.rpy:22
translate english act3_jump_51af5dfd:

    # n "漩涡里，浮着一些影子。"
    n "In the vortex, some shadows drift."

# game/chapters/ch3_jump.rpy:23
translate english act3_jump_9c5cbbd7:

    # n "一个抱着襁褓的女人。一个坐在长椅上的少女。一个剪短发的年轻人。一个穿围裙的男人。一个老人。"
    n "A woman holding a swaddled bundle. A girl on a bench. A young person with cropped hair. A man in an apron. An old man."

# game/chapters/ch3_jump.rpy:24
translate english act3_jump_dd777c0f:

    # n "它们飘着，靠近，几乎要重叠在一起——"
    n "They drift close, almost overlapping —"

# game/chapters/ch3_jump.rpy:25
translate english act3_jump_61e2bbc0:

    # n "可一晃，又散开了。"
    n "and then flicker apart."

# game/chapters/ch3_jump.rpy:27
translate english act3_jump_656bef99:

    # mono "（那些影子……)"
    mono "(Those shadows...)"

# game/chapters/ch3_jump.rpy:28
translate english act3_jump_0c72bb59:

    # mono "（我眯起眼，想看清它们。)"
    mono "(I squint, trying to make them out.)"

# game/chapters/ch3_jump.rpy:29
translate english act3_jump_6bd1bd3b:

    # mono "（它们好像……是同一个轮廓。)"
    mono "(They look like... the same outline.)"

# game/chapters/ch3_jump.rpy:30
translate english act3_jump_57348d1a:

    # mono "（可每当我快要抓住那个念头，它就滑走了。)"
    mono "(But every time I nearly grasp the thought, it slips away.)"

# game/chapters/ch3_jump.rpy:31
translate english act3_jump_dadbffe4:

    # mono "（像是一个我快要想起、却还没想起的梦。)"
    mono "(Like a dream I'm on the edge of remembering.)"

# game/chapters/ch3_jump.rpy:39
translate english act3_jump_6ae90e06:

    # n "1963年。四月。公园。"
    n "1963. April. The park."

# game/chapters/ch3_jump.rpy:40
translate english act3_jump_ca6c5c84:

    # n "樱花开着。阳光碎成一地金子。"
    n "Blossoms out. Sunlight shattered into a thousand gold coins on the ground."

# game/chapters/ch3_jump.rpy:42
translate english act3_jump_7d86cd95:

    # n "约翰从白光里走出来，站在公园门口。"
    n "John steps out of the white light at the park gate."

# game/chapters/ch3_jump.rpy:43
translate english act3_jump_cdac8e78:

    # n "他还穿着1970年的旧夹克，像个闯入彩色照片的黑白影子。"
    n "Still in his 1970 jacket, a black-and-white figure wandered into a color photograph."

# game/chapters/ch3_jump.rpy:45
translate english act3_jump_0d4595bc:

    # n "然后，他看见了她。"
    n "Then he sees her."

# game/chapters/ch3_jump.rpy:50
translate english act3_jump_c313c184:

    # n "长椅上，坐着一个少女。"
    n "On the bench, a girl."

# game/chapters/ch3_jump.rpy:51
translate english act3_jump_19c0a260:

    # n "膝盖上摊着一本书，但她没在看。"
    n "A book open on her knee, but she isn't reading."

# game/chapters/ch3_jump.rpy:52
translate english act3_jump_36b4f880:

    # n "她在看人来人往。"
    n "She's watching people come and go."

# game/chapters/ch3_jump.rpy:54
translate english act3_jump_7d6d5f0f:

    # n "约翰愣住了。"
    n "John goes still."

# game/chapters/ch3_jump.rpy:55
translate english act3_jump_1f078faf:

    # n "这张脸。"
    n "That face."

# game/chapters/ch3_jump.rpy:56
translate english act3_jump_dacae13c:

    # n "他认识这张脸。"
    n "He knows that face."

# game/chapters/ch3_jump.rpy:57
translate english act3_jump_a8bae454:

    # n "他在镜子里见过。在很多年前的镜子里。"
    n "He's seen it in the mirror. In a mirror, years and years ago."

# game/chapters/ch3_jump.rpy:58
translate english act3_jump_129ca3de:

    # n "可那怎么可能……"
    n "But how could that be..."

# game/chapters/ch3_jump.rpy:60
translate english act3_jump_b53d6fd9:

    # john "（不……)"
    john "(No...)"

# game/chapters/ch3_jump.rpy:61
translate english act3_jump_fd494b1a:

    # john "（这张脸……我……)"
    john "(This face... I...)"

# game/chapters/ch3_jump.rpy:62
translate english act3_jump_6185e1aa:

    # john "（为什么，我的心跳得这么快？)"
    john "(Why is my heart hammering like this?)"

# game/chapters/ch3_jump.rpy:63
translate english act3_jump_d6cc047f:

    # john "（为什么，我觉得我认识她。认识得……比认识任何人都深？)"
    john "(Why do I feel like I know her — better than I've known anyone?)"

# game/chapters/ch3_jump.rpy:65
translate english act3_jump_ec3273a4:

    # mono "（他的腿，不听使唤地，走了过去。)"
    mono "(His legs carry him forward against his will.)"

# game/chapters/ch3_jump.rpy:66
translate english act3_jump_73a4113a:

    # mono "（他不知道自己要做什么。)"
    mono "(He doesn't know what he's doing.)"

# game/chapters/ch3_jump.rpy:67
translate english act3_jump_f5bdba23:

    # mono "（他张开嘴，话，自己冒了出来——)"
    mono "(He opens his mouth, and the words come out on their own —)"

# game/chapters/ch3_jump.rpy:69
translate english act3_jump_eb5f31e8:

    # stranger "你在看人。"
    stranger "You're watching people."

# game/chapters/ch3_jump.rpy:71
translate english act3_jump_a1bff7bd:

    # n "约翰听见自己说出了这句话。"
    n "John hears himself say it."

# game/chapters/ch3_jump.rpy:72
translate english act3_jump_b89a994e:

    # n "然后，一阵寒意，从他的脊背爬了上来。"
    n "And then a chill crawls up his spine."

# game/chapters/ch3_jump.rpy:73
translate english act3_jump_465aea48:

    # n "这句话……他听过。"
    n "He's heard that sentence before."

# game/chapters/ch3_jump.rpy:74
translate english act3_jump_545029ee:

    # n "有人，对他说过这句话。一字不差。"
    n "Someone said it to him. Word for word."

# game/chapters/ch3_jump.rpy:75
translate english act3_jump_38093d90:

    # n "是什么时候？是谁？……他想不起来。它就像在舌尖上，却怎么也抓不住。"
    n "When? Who?... He can't remember. It's right on the tip of his tongue, and he can't catch it."

# game/chapters/ch3_jump.rpy:77
translate english act3_jump_222a2f5f:

    # jane "……什么？"
    jane "...What?"

# game/chapters/ch3_jump.rpy:78
translate english act3_jump_3e3ccf75:

    # stranger "你坐在这儿，看人来人往。你在想——没有一个人是为我而来的。"
    stranger "You sit here watching them come and go. You're thinking — not one of them is here for me."

# game/chapters/ch3_jump.rpy:80
translate english act3_jump_f8e77550:

    # n "少女的书，从膝盖上滑下去了。"
    n "The book slides off the girl's knee."

# game/chapters/ch3_jump.rpy:81
translate english act3_jump_9920d3b9:

    # n "约翰看着她的眼睛——那双灰绿色的、冬天湖面一样的眼睛。"
    n "John looks into her eyes — those grey-green eyes, like a winter lake."

# game/chapters/ch3_jump.rpy:82
translate english act3_jump_09bacfd1:

    # n "有那么一瞬间，他觉得，自己什么都明白了。"
    n "For one instant he feels he understands everything."

# game/chapters/ch3_jump.rpy:83
translate english act3_jump_73a515a0:

    # n "可那个「明白」，像水里的倒影。他一伸手，就碎了。"
    n "But the \"understanding\" is like a reflection in water. He reaches for it, and it breaks."

# game/chapters/ch3_jump.rpy:85
translate english act3_jump_c50734ae:

    # john "（我懂她。)"
    john "(I understand her.)"

# game/chapters/ch3_jump.rpy:86
translate english act3_jump_fbbfdc6c:

    # john "（我懂她说的每一个字，和每一个没说出口的字。)"
    john "(Every word she says, and every word she doesn't.)"

# game/chapters/ch3_jump.rpy:87
translate english act3_jump_81613bfe:

    # john "（这世上，再没有第二个人，能像我这样懂她。)"
    john "(No one else in this world could understand her the way I do.)"

# game/chapters/ch3_jump.rpy:88
translate english act3_jump_d352ec32:

    # john "（……为什么？为什么，我会这样懂她？)"
    john "(...Why? Why do I understand her like this?)"

# game/chapters/ch3_jump.rpy:90
translate english act3_jump_73ce62ae:

    # mono "（他爱上了她。)"
    mono "(He falls in love with her.)"

# game/chapters/ch3_jump.rpy:91
translate english act3_jump_a6a1f5c2:

    # mono "（他怎么能不爱她。)"
    mono "(How could he not.)"

# game/chapters/ch3_jump.rpy:92
translate english act3_jump_1a105234:

    # mono "（和她在一起，他这辈子，第一次觉得「完整」。)"
    mono "(With her, for the first time in his life, he feels whole.)"

# game/chapters/ch3_jump.rpy:93
translate english act3_jump_8267b71a:

    # mono "（好像他弄丢了很久的什么东西，终于，又回到了他手里。)"
    mono "(As if something he lost long ago has finally come back into his hands.)"

# game/chapters/ch3_jump.rpy:95
translate english act3_jump_cdb04bd4:

    # n "樱花落下来。"
    n "The blossoms fall."

# game/chapters/ch3_jump.rpy:96
translate english act3_jump_1d858712:

    # n "他吻了她。"
    n "He kisses her."

# game/chapters/ch3_jump.rpy:97
translate english act3_jump_a595f805:

    # n "就像……很久以前，有人这样吻过他。"
    n "Just as... once, long ago, someone kissed him."

# game/chapters/ch3_jump.rpy:98
translate english act3_jump_d88e994e:

    # n "这个念头一闪。他抓不住。他也不想抓。"
    n "The thought flickers. He can't hold it. He doesn't want to."

# game/chapters/ch3_jump.rpy:100
translate english act3_jump_7ee9e4e4:

    # mono "（有什么东西，咔哒一声，合上了。)"
    mono "(Something clicks shut.)"

# game/chapters/ch3_jump.rpy:101
translate english act3_jump_5a249729:

    # mono "（可他不知道，那是什么。)"
    mono "(But he doesn't know what.)"

# game/chapters/ch3_jump.rpy:109
translate english act3_jump_a6cb787c:

    # n "而与此同时——"
    n "And meanwhile —"

# game/chapters/ch3_jump.rpy:110
translate english act3_jump_d64b04e5:

    # n "在时间漩涡的另一端，我抱着一个襁褓。"
    n "at the other end of the vortex, I'm holding a swaddled bundle."

# game/chapters/ch3_jump.rpy:112
translate english act3_jump_df77cb5b:

    # mono "（这是我的部分。)"
    mono "(This is my part.)"

# game/chapters/ch3_jump.rpy:113
translate english act3_jump_1324a376:

    # mono "（我一直知道，总有一天，会轮到我来做这件事。)"
    mono "(I always knew that someday it would be my turn to do this.)"

# game/chapters/ch3_jump.rpy:114
translate english act3_jump_dfcc524b:

    # mono "（只是我不知道……为什么，我会这么笃定。)"
    mono "(I just don't know... why I'm so sure of it.)"

# game/chapters/ch3_jump.rpy:119
translate english act3_jump_d376d656:

    # n "1945年。克利夫兰。冬天。"
    n "1945. Cleveland. Winter."

# game/chapters/ch3_jump.rpy:120
translate english act3_jump_665954f0:

    # n "雪下得很大。一家孤儿院的铁门，锈迹斑斑。"
    n "The snow is coming down hard. The iron gate of an orphanage, rusted through."

# game/chapters/ch3_jump.rpy:122
translate english act3_jump_5b5f1145:

    # n "我站在门外，怀里是一个女婴。"
    n "I stand outside the gate, holding a baby girl."

# game/chapters/ch3_jump.rpy:123
translate english act3_jump_8a494b3f:

    # n "她睡着了。左眉尾，有一道极细的胎记。"
    n "She's asleep. At the tail of her left eyebrow, the faintest birthmark."

# game/chapters/ch3_jump.rpy:128
translate english act3_jump_43d95752:

    # n "我弯下腰，把她轻轻放在台阶上。"
    n "I bend down and set her gently on the steps."

# game/chapters/ch3_jump.rpy:129
translate english act3_jump_1ef05d14:

    # n "雪落在她的襁褓上。"
    n "Snow settles on her swaddling."

# game/chapters/ch3_jump.rpy:131
translate english act3_jump_ee0eac71:

    # mono "（对不起。)"
    mono "(I'm sorry.)"

# game/chapters/ch3_jump.rpy:132
translate english act3_jump_51b92a3c:

    # mono "（也……谢谢你。)"
    mono "(And... thank you.)"

# game/chapters/ch3_jump.rpy:133
translate english act3_jump_e713b53e:

    # mono "（我必须，把你放在这里。)"
    mono "(I have to leave you here.)"

# game/chapters/ch3_jump.rpy:134
translate english act3_jump_ce37afc2:

    # mono "（我不知道为什么。我只是知道——我必须。)"
    mono "(I don't know why. I only know — I must.)"

# game/chapters/ch3_jump.rpy:135
translate english act3_jump_16c4ef93:

    # mono "（好像只有这样，一切才能……开始。)"
    mono "(As if only this way can everything... begin.)"

# game/chapters/ch3_jump.rpy:136
translate english act3_jump_e55f6e91:

    # mono "（我弯下腰，把她，轻轻放下。)"
    mono "(I bend and lay her down, gently.)"

# game/chapters/ch3_jump.rpy:137
translate english act3_jump_9f68c86d:

    # mono "（心口，闷闷地疼。)"
    mono "(My chest aches, dully.)"

# game/chapters/ch3_jump.rpy:139
translate english act3_jump_d547dded:

    # n "门里传来脚步声。修女要出来了。"
    n "Footsteps inside. A nun is coming."

# game/chapters/ch3_jump.rpy:140
translate english act3_jump_7b9d31f6:

    # n "我退进雪里，退进风里，退进时间的褶皱里。"
    n "I retreat into the snow, into the wind, into the folds of time."

# game/chapters/ch3_jump.rpy:142
translate english act3_jump_98cb2b85:

    # n "身后，传来一声婴儿的啼哭。"
    n "Behind me, a baby cries."

# game/chapters/ch3_jump.rpy:143
translate english act3_jump_c5caf3c2:

    # n "嘹亮得像，一个世界的开端。"
    n "Bright as the beginning of a world."

# game/chapters/ch3_jump.rpy:145
translate english act3_jump_ffb1ad6b:

    # mono "（又有什么东西，咔哒一声，合上了。)"
    mono "(Something else clicks shut.)"

# game/chapters/ch3_jump.rpy:146
translate english act3_jump_e814b149:

    # mono "（我还是不知道，那是什么。)"
    mono "(I still don't know what.)"

# game/chapters/ch3_jump.rpy:154
translate english act3_jump_259a9bce:

    # n "1985年。一间灰色的办公室。"
    n "1985. A grey office."

# game/chapters/ch3_jump.rpy:155
translate english act3_jump_612061d2:

    # n "约翰坐在我对面。"
    n "John sits across from me."

# game/chapters/ch3_jump.rpy:156
translate english act3_jump_7a65e693:

    # n "从公园回来以后，他就一直是这个样子——魂不守舍，像是被什么东西，从里面掏空了。"
    n "Ever since the park, he's been like this — hollowed out, like something scooped the inside of him clean."

# game/chapters/ch3_jump.rpy:158
translate english act3_jump_86ed2394:

    # john "那个公园里的姑娘……"
    john "That girl in the park..."

# game/chapters/ch3_jump.rpy:159
translate english act3_jump_c7886bad:

    # n "他盯着自己的手，看了很久。"
    n "He stares at his own hands for a long time."

# game/chapters/ch3_jump.rpy:160
translate english act3_jump_afb73ea8:

    # john "我认识她。我他妈的，太认识她了。"
    john "I know her. God help me, I know her too well."

# game/chapters/ch3_jump.rpy:161
translate english act3_jump_68b59413:

    # john "我懂她，懂到……害怕。"
    john "I understand her so well it... scares me."

# game/chapters/ch3_jump.rpy:162
translate english act3_jump_77e36ecb:

    # n "他抬起头，眼睛是红的。"
    n "He looks up, eyes red."

# game/chapters/ch3_jump.rpy:163
translate english act3_jump_866cb239:

    # john "酒保。我是不是……对她做了什么，很可怕的事？"
    john "Bartender. Did I... do something terrible to her?"

# game/chapters/ch3_jump.rpy:165
translate english act3_jump_3cf2e520:

    # mono "（我张了张嘴。)"
    mono "(I open my mouth.)"

# game/chapters/ch3_jump.rpy:166
translate english act3_jump_e47a3d09:

    # mono "（答案，就在我嘴边。)"
    mono "(The answer is right there.)"

# game/chapters/ch3_jump.rpy:167
translate english act3_jump_141bd69c:

    # mono "（可它还没有成形。它还差……最后一块。)"
    mono "(But it hasn't taken shape yet. It's still missing... one last piece.)"

# game/chapters/ch3_jump.rpy:169
translate english act3_jump_5639a281:

    # bureau "时间局需要你这样……「完整」的人。"
    bureau "The Temporal Bureau needs someone... complete, like you."

# game/chapters/ch3_jump.rpy:170
translate english act3_jump_fdbe9b79:

    # bureau "没有过去可以被威胁。没有亲人可以被挟持。"
    bureau "No past to threaten. No loved ones to hold over you."

# game/chapters/ch3_jump.rpy:171
translate english act3_jump_e59481c7:

    # bureau "你，就是你自己的全部。"
    bureau "You are your own everything."

# game/chapters/ch3_jump.rpy:173
translate english act3_jump_c779a672:

    # john "……完整。"
    john "...Complete."

# game/chapters/ch3_jump.rpy:174
translate english act3_jump_1feb5c90:

    # n "他咀嚼着这个词，像是觉得它又对，又荒谬。"
    n "He turns the word over, as if it's both true and absurd."

# game/chapters/ch3_jump.rpy:175
translate english act3_jump_64894295:

    # john "……好。我加入。"
    john "...Fine. I'm in."

# game/chapters/ch3_jump.rpy:177
translate english act3_jump_26246405:

    # n "他站起来，走到门口，停下，回头看我。"
    n "He stands, walks to the door, stops, and looks back."

# game/chapters/ch3_jump.rpy:178
translate english act3_jump_3e69739c:

    # john "酒保。"
    john "Bartender."

# game/chapters/ch3_jump.rpy:179
translate english act3_jump_4be9d3cd:

    # john "你知道些什么，对不对？"
    john "You know something, don't you?"

# game/chapters/ch3_jump.rpy:180
translate english act3_jump_d18df6b8:

    # john "关于我。关于她。关于……这一切。"
    john "About me. About her. About... all of this."

# game/chapters/ch3_jump.rpy:183
translate english act3_jump_b636431f:

    # bart "……" nointeract
    bart "..." nointeract

# game/chapters/ch3_jump.rpy:187
translate english act3_jump_4d026005:

    # john "……"
    john "..."

# game/chapters/ch3_jump.rpy:188
translate english act3_jump_ad1950dd:

    # n "他点点头，像是接受了一个他还不懂的答案。"
    n "He nods, as if accepting an answer he doesn't yet understand."

# game/chapters/ch3_jump.rpy:189
translate english act3_jump_047ddca1:

    # john "好。我等。"
    john "Fine. I'll wait."

# game/chapters/ch3_jump.rpy:193
translate english act3_jump_882d55d0:

    # john "连你也不知道？"
    john "You don't know either?"

# game/chapters/ch3_jump.rpy:194
translate english act3_jump_09944764:

    # n "他苦笑了一下。"
    n "He gives a bitter little smile."

# game/chapters/ch3_jump.rpy:195
translate english act3_jump_23c2e439:

    # john "哈。原来我们，都在雾里。"
    john "Ha. So we're both in the fog."

# game/chapters/ch3_jump.rpy:200
translate english act3_jump_04464b4e:

    # john "别道歉。"
    john "Don't apologize."

# game/chapters/ch3_jump.rpy:201
translate english act3_jump_8c1669a0:

    # n "他摆摆手。"
    n "He waves a hand."

# game/chapters/ch3_jump.rpy:202
translate english act3_jump_9cb65cf7:

    # john "你和我一样。都在做……不得不做的事。"
    john "You're like me. Doing... what has to be done."

# game/chapters/ch3_jump.rpy:204
translate english act3_jump_0aa7b332:

    # n "他推门出去，走进1985年的光里。"
    n "He pushes through the door and walks into the light of 1985."

# game/chapters/ch3_jump.rpy:205
translate english act3_jump_9989d218:

    # n "去成为，他注定要成为的人。"
    n "To become the person he was always going to become."

# game/chapters/ch3_jump.rpy:206
translate english act3_jump_9c3d2bde:

    # n "而我，还差最后一步，才能看清，那个「注定」，到底是什么。"
    n "And I'm still one step short of seeing what that \"always\" really is."

# game/chapters/ch3_jump.rpy:214
translate english act3_jump_b5ca8918:

    # n "我回来了。"
    n "I'm back."

# game/chapters/ch3_jump.rpy:215
translate english act3_jump_b5cbcd28:

    # n "1970年。酒吧。凌晨三点四十分。"
    n "1970. The bar. 3:40 in the morning."

# game/chapters/ch3_jump.rpy:216
translate english act3_jump_bc167d88:

    # n "雨还在下。钟还在走。"
    n "The rain is still falling. The clock is still ticking."

# game/chapters/ch3_jump.rpy:217
translate english act3_jump_c6c1577d:

    # n "吧台上，那只杯子还在原处，杯底剩着一圈琥珀色的光。"
    n "The glass is still on the counter, a ring of amber light left in the bottom."

# game/chapters/ch3_jump.rpy:219
translate english act3_jump_ec7c5af6:

    # n "一切都和我离开时，一模一样。"
    n "Everything is exactly as I left it."

# game/chapters/ch3_jump.rpy:220
translate english act3_jump_6c5b2b2a:

    # n "仿佛什么都没有发生过。"
    n "As if nothing happened."

# game/chapters/ch3_jump.rpy:222
translate english act3_jump_1b038770:

    # mono "（可有什么东西，不一样了。)"
    mono "(But something is different.)"

# game/chapters/ch3_jump.rpy:223
translate english act3_jump_9c434dbd:

    # mono "（这一晚，我见过的一切——)"
    mono "(Everything I've seen tonight —)"

# game/chapters/ch3_jump.rpy:224
translate english act3_jump_1657f257:

    # mono "（雪里的婴儿。长椅上的少女。公园里的他。手术台上的她。写故事的他。舱里的他。1985年的他。)"
    mono "(The baby in the snow. The girl on the bench. Him in the park. Her on the table. Him writing his stories. Him in the pod. Him in 1985.)"

# game/chapters/ch3_jump.rpy:225
translate english act3_jump_a7f41ba4:

    # mono "（它们在我脑子里，转啊，转啊。)"
    mono "(It's all turning in my head, round and round.)"

# game/chapters/ch3_jump.rpy:226
translate english act3_jump_8bd9e6fd:

    # mono "（像那条漩涡里的蛇。)"
    mono "(Like that snake in the vortex.)"

# game/chapters/ch3_jump.rpy:227
translate english act3_jump_e1082eca:

    # mono "（那个我一直不敢去看的东西……)"
    mono "(The thing I've been afraid to look at...)"

# game/chapters/ch3_jump.rpy:228
translate english act3_jump_2fe7f8be:

    # mono "（现在，我躲不掉了。)"
    mono "(I can't hide from it anymore.)"

# game/chapters/ch3_jump.rpy:234
translate english act3_jump_e830ac24:

    # n "我走到镜子前面。"
    n "I walk to the mirror."

# game/chapters/ch3_jump.rpy:235
translate english act3_jump_586f9a3f:

    # n "镜子里，是我。"
    n "The person in it is me."

# game/chapters/ch3_jump.rpy:236
translate english act3_jump_587aa9b2:

    # n "我盯着那双灰绿色的眼睛。盯了很久，很久。"
    n "I stare into those grey-green eyes. For a long, long time."

# game/chapters/ch3_jump.rpy:238
translate english act3_jump_1f809203:

    # mono "（那双眼睛。)"
    mono "(Those eyes.)"

# game/chapters/ch3_jump.rpy:239
translate english act3_jump_fb469318:

    # mono "（我在婴儿的脸上，见过。)"
    mono "(I've seen them on the baby's face.)"

# game/chapters/ch3_jump.rpy:240
translate english act3_jump_663b9df7:

    # mono "（我在少女的脸上，见过。)"
    mono "(On the girl's face.)"

# game/chapters/ch3_jump.rpy:241
translate english act3_jump_bbe696f5:

    # mono "（我在他的脸上，见过。)"
    mono "(On his face.)"

# game/chapters/ch3_jump.rpy:242
translate english act3_jump_10a6ab35:

    # mono "（我在……镜子里，天天都见。)"
    mono "(In this mirror — every single day.)"

# game/chapters/ch3_jump.rpy:244
translate english act3_jump_aa42f963:

    # n "我的心，开始狂跳。"
    n "My heart starts to hammer."

# game/chapters/ch3_jump.rpy:245
translate english act3_jump_da7ea0e1:

    # n "那个我一直不敢去看的念头，那个一伸手就碎掉的「明白」——"
    n "The thought I've been afraid to look at, the \"understanding\" that broke every time I reached for it —"

# game/chapters/ch3_jump.rpy:246
translate english act3_jump_c6838af6:

    # n "这一次，我没有再让它逃走。"
    n "this time I don't let it go."

# game/chapters/ch3_jump.rpy:247
translate english act3_jump_83a9b41f:

    # n "我伸出手，一把，抓住了它。"
    n "I reach out and grab it."

# game/chapters/ch3_jump.rpy:249
translate english act3_jump_fa1c728b:

    # mono "（婴儿。)"
    mono "(The baby.)"

# game/chapters/ch3_jump.rpy:250
translate english act3_jump_205de1a8:

    # mono "（那个被放在雪地里的婴儿——)"
    mono "(The one left in the snow —)"

# game/chapters/ch3_jump.rpy:252
translate english act3_jump_7326d7a3:

    # n "我对着镜子，说出了声。声音抖得不成样子。"
    n "I say it out loud, to the mirror. My voice shakes apart."

# game/chapters/ch3_jump.rpy:254
translate english act3_jump_a0dda339:

    # bart "婴儿……是你。"
    bart "The baby... is you."

# game/chapters/ch3_jump.rpy:256
translate english act3_jump_36ac6469:

    # mono "（少女。)"
    mono "(The girl.)"

# game/chapters/ch3_jump.rpy:257
translate english act3_jump_90f380e6:

    # mono "（那个坐在长椅上，看人来人往的少女——)"
    mono "(The one on the bench, watching people come and go —)"

# game/chapters/ch3_jump.rpy:259
translate english act3_jump_35be10e4:

    # bart "简……是你。"
    bart "Jane... is you."

# game/chapters/ch3_jump.rpy:261
translate english act3_jump_744dc9bd:

    # mono "（那个男人。)"
    mono "(The man.)"

# game/chapters/ch3_jump.rpy:262
translate english act3_jump_5749bfca:

    # mono "（那个在公园里，吻了她，又抛弃了她的人——)"
    mono "(The one who kissed her in the park, and then abandoned her —)"

# game/chapters/ch3_jump.rpy:264
translate english act3_jump_bdd397ef:

    # bart "那个男人……也是你。"
    bart "That man... is you too."

# game/chapters/ch3_jump.rpy:266
translate english act3_jump_7b6c48f8:

    # n "我的声音，越来越大。"
    n "My voice gets louder."

# game/chapters/ch3_jump.rpy:268
translate english act3_jump_e6fc2bfb:

    # bart "你的母亲，是你。你的父亲，是你。"
    bart "Your mother is you. Your father is you."

# game/chapters/ch3_jump.rpy:269
translate english act3_jump_19dbda77:

    # bart "你爱的那个人，是你。"
    bart "The person you loved — is you."

# game/chapters/ch3_jump.rpy:270
translate english act3_jump_d92e0ba5:

    # bart "你生下的那个孩子——"
    bart "The baby you gave birth to —"

# game/chapters/ch3_jump.rpy:271
translate english act3_jump_1386e81f:

    # bart "还是你。"
    bart "is still you."

# game/chapters/ch3_jump.rpy:273
translate english act3_jump_5dfcf892:

    # n "镜子里的我，眼泪流了下来。"
    n "In the mirror, I'm crying."

# game/chapters/ch3_jump.rpy:274
translate english act3_jump_ff39f076:

    # n "可我在笑。"
    n "And I'm smiling."

# game/chapters/ch3_jump.rpy:276
translate english act3_jump_fd448957:

    # bart "一整支军队。"
    bart "A whole army."

# game/chapters/ch3_jump.rpy:277
translate english act3_jump_7c2b6d74:

    # bart "你他妈的……就是你自己的一整支军队。"
    bart "You're your own goddamn whole army."

# game/chapters/ch3_jump.rpy:279
translate english act3_jump_d7455080:

    # n "然后，我看向镜子里，那个穿着围裙的我。"
    n "Then I look at the me in the mirror — the one in the apron."

# game/chapters/ch3_jump.rpy:280
translate english act3_jump_6b22fe35:

    # n "那个，从一开始，就站在吧台后面，听他讲故事的我。"
    n "The one who's been standing behind this bar, listening to his story, from the very beginning."

# game/chapters/ch3_jump.rpy:282
translate english act3_jump_22fc5bc4:

    # mono "（还有我。)"
    mono "(And me.)"

# game/chapters/ch3_jump.rpy:283
translate english act3_jump_d2fbcd78:

    # mono "（那个酒保。)"
    mono "(The bartender.)"

# game/chapters/ch3_jump.rpy:284
translate english act3_jump_3c89fdf8:

    # mono "（那个，从第一眼起，就觉得「我认识他」的我。)"
    mono "(The one who, from the first glance, felt \"I know him.\")"

# game/chapters/ch3_jump.rpy:285
translate english act3_jump_9f167eb5:

    # mono "（那个，心口一直闷闷地疼的我。)"
    mono "(The one whose chest has ached this whole time.)"

# game/chapters/ch3_jump.rpy:287
translate english act3_jump_a08a0894:

    # bart "而我……"
    bart "And I..."

# game/chapters/ch3_jump.rpy:288
translate english act3_jump_db45063a:

    # n "我把手，贴在冰冷的镜面上。"
    n "I press my hand to the cold glass."

# game/chapters/ch3_jump.rpy:289
translate english act3_jump_eedb0495:

    # bart "也是我。"
    bart "Am me too."

# game/chapters/ch3_jump.rpy:290
translate english act3_jump_77ed7294:

    # bart "是你。"
    bart "Am you."

# game/chapters/ch3_jump.rpy:291
translate english act3_jump_483d76d7:

    # bart "是，很多很多年以后的，你。"
    bart "Am you — a great many years from now."

# game/chapters/ch3_jump.rpy:293
translate english act3_jump_b00e3af0:

    # n "镜子里，镜子里外，所有的「我」，都在看着彼此。"
    n "In the mirror, on both sides of the glass, every \"me\" is looking at every other."

# game/chapters/ch3_jump.rpy:294
translate english act3_jump_cf98d4df:

    # n "婴儿。少女。他。我。老人。"
    n "Baby. Girl. Him. Me. The old man."

# game/chapters/ch3_jump.rpy:295
translate english act3_jump_4b210e77:

    # n "是同一个人。"
    n "The same person."

# game/chapters/ch3_jump.rpy:296
translate english act3_jump_ec8273c1:

    # n "从头到尾，从生到死，从开始，到开始——"
    n "From beginning to end, from birth to death, from the start back to the start —"

# game/chapters/ch3_jump.rpy:297
translate english act3_jump_0d22aff5:

    # n "只有一个人。"
    n "only one person."

# game/chapters/ch3_jump.rpy:299
translate english act3_jump_0513cd25:

    # mono "（现在，你知道了。)"
    mono "(Now you know.)"

# game/chapters/ch3_jump.rpy:300
translate english act3_jump_4248578c:

    # mono "（那个婴儿是谁。那个少女是谁。那个男人是谁。)"
    mono "(Who the baby is. Who the girl is. Who the man is.)"

# game/chapters/ch3_jump.rpy:301
translate english act3_jump_cad1e125:

    # mono "（还有——我是谁。)"
    mono "(And — who I am.)"

# game/chapters/ch3_jump.rpy:302
translate english act3_jump_2248a435:

    # mono "（其实，你早就该猜到的。)"
    mono "(Really, you should have guessed it long ago.)"

# game/chapters/ch3_jump.rpy:303
translate english act3_jump_d7b1f47f:

    # mono "（因为，从你走进这家酒吧的第一眼起——)"
    mono "(Because from the first moment you walked into this bar —)"

# game/chapters/ch3_jump.rpy:304
translate english act3_jump_0fe45277:

    # mono "（你就一直在，照镜子。)"
    mono "(you've been looking into a mirror.)"

# game/chapters/ch3_jump.rpy:306
translate english act3_jump_72d05f0e:

    # n "酒吧里，安静极了。"
    n "The bar is utterly quiet."

# game/chapters/ch3_jump.rpy:307
translate english act3_jump_fb3a0db6:

    # n "只有雨。只有钟。"
    n "Only the rain. Only the clock."

# game/chapters/ch3_jump.rpy:308
translate english act3_jump_ae1130d4:

    # n "还有我，一个人，站在一屋子的「自己」中间。"
    n "And me, alone, standing in a room full of myself."

translate english strings:

    # game/chapters/ch3_jump.rpy:185
    old "「你会明白的。等你准备好的时候。」"
    new "\"You'll understand. When you're ready.\""

    # game/chapters/ch3_jump.rpy:191
    old "「我……也还在弄明白。」"
    new "\"I'm... still working it out myself.\""

    # game/chapters/ch3_jump.rpy:197
    old "「对不起。」"
    new "\"I'm sorry.\""
