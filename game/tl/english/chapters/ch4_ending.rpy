    mono "(Now there's only me left.)"

# game/chapters/ch4_ending.rpy:17
translate english ending_hub_4034e7b6:

    # mono "（只剩下「我」，和这个「我」。)"
    mono "(Only \"me,\" and this \"me.\")"

# game/chapters/ch4_ending.rpy:40
translate english ending_rage_3fa7c716:

    # n "我看着杯子里的酒。"
    n "I look at the liquor in the glass."

# game/chapters/ch4_ending.rpy:41
translate english ending_rage_bdf83dbc:

    # n "琥珀色的液体，晃啊晃，像一个小小的、旋转的牢笼。"
    n "The amber swirls and swirls, like a small spinning cage."

# game/chapters/ch4_ending.rpy:43
translate english ending_rage_fff5ae4f:

    # mono "（一个环。)"
    mono "(A loop.)"

# game/chapters/ch4_ending.rpy:44
translate english ending_rage_34a5f60d:

    # mono "（一个该死的、完美的、密不透风的环。)"
    mono "(A goddamn perfect, airtight loop.)"

# game/chapters/ch4_ending.rpy:46
translate english ending_rage_d7a7b8a2:

    # n "我忽然觉得恶心。"
    n "I feel sick, all at once."

# game/chapters/ch4_ending.rpy:47
translate english ending_rage_41c9fade:

    # n "我把杯子，狠狠砸在吧台上。"
    n "I smash the glass down on the bar."

# game/chapters/ch4_ending.rpy:48
translate english ending_rage_968129be:

    # n "玻璃碎了。酒溅出来，在木头台面上漫开，像一滩血。"
    n "It shatters. The whiskey spreads across the wood like a pool of blood."

# game/chapters/ch4_ending.rpy:50
translate english ending_rage_e7f9e0d4:

    # mono "（凭什么？)"
    mono "(Why?)"

# game/chapters/ch4_ending.rpy:51
translate english ending_rage_fbd8d416:

    # mono "（凭什么，我要把我自己，一次又一次地——)"
    mono "(Why must I, again and again —)"

# game/chapters/ch4_ending.rpy:52
translate english ending_rage_f580e8d9:

    # mono "（遗弃在雪地里。抛弃在长椅上。剖开在手术台上。)"
    mono "(abandon myself in the snow. Desert myself on a bench. Cut myself open on a table.)"

# game/chapters/ch4_ending.rpy:53
translate english ending_rage_0bf6c363:

    # mono "（凭什么，我的母亲是我，我的爱人是我，我的刽子手，也是我？)"
    mono "(Why must my mother be me, my lover be me, my executioner be me too?)"

# game/chapters/ch4_ending.rpy:55
translate english ending_rage_772995bd:

    # n "我抓起酒瓶，想再砸一个。"
    n "I grab the bottle to smash another."

# game/chapters/ch4_ending.rpy:56
translate english ending_rage_bf3609fa:

    # n "可是手举到一半，停住了。"
    n "But my hand stops halfway up."

# game/chapters/ch4_ending.rpy:58
translate english ending_rage_23fdc04e:

    # mono "（砸了，又怎么样呢？)"
    mono "(And if I do — then what?)"

# game/chapters/ch4_ending.rpy:59
translate english ending_rage_2ca9248c:

    # mono "（我恨的这个「命运」——)"
    mono "(This \"fate\" I hate —)"

# game/chapters/ch4_ending.rpy:60
translate english ending_rage_641e1ab8:

    # mono "（就是我。)"
    mono "(is me.)"

# game/chapters/ch4_ending.rpy:61
translate english ending_rage_cadddfae:

    # mono "（我恨的每一寸，都是我自己的血肉。)"
    mono "(Every inch I hate is my own flesh.)"

# game/chapters/ch4_ending.rpy:62
translate english ending_rage_5034bf86:

    # mono "（我就算把自己烧成灰——)"
    mono "(Even if I burn myself to ash —)"

# game/chapters/ch4_ending.rpy:63
translate english ending_rage_33439746:

    # mono "（灰里，也还是会长出这条蛇。)"
    mono "(the snake will still grow back out of the ashes.)"

# game/chapters/ch4_ending.rpy:65
translate english ending_rage_51a3e6af:

    # n "我站在一片狼藉里，喘着气。"
    n "I stand in the wreckage, breathing hard."

# game/chapters/ch4_ending.rpy:66
translate english ending_rage_d84c8ee5:

    # n "然后，我慢慢地，慢慢地，蹲下去，开始捡那些碎玻璃。"
    n "Then, slowly, I crouch down and begin picking up the broken glass."

# game/chapters/ch4_ending.rpy:68
translate english ending_rage_5cb47361:

    # mono "（我恨你。)"
    mono "(I hate you.)"

# game/chapters/ch4_ending.rpy:69
translate english ending_rage_3e2597c1:

    # mono "（我恨你，恨得……)"
    mono "(I hate you so much...)"

# game/chapters/ch4_ending.rpy:70
translate english ending_rage_e8972bd9:

    # mono "（只能继续爱你。)"
    mono "(that all I can do is go on loving you.)"

# game/chapters/ch4_ending.rpy:71
translate english ending_rage_c9b6a80f:

    # mono "（因为我，只有你。)"
    mono "(Because I've only got you.)"

# game/chapters/ch4_ending.rpy:73
translate english ending_rage_9a594c56:

    # n "天快亮了。"
    n "Dawn is almost here."

# game/chapters/ch4_ending.rpy:74
translate english ending_rage_9f18ab97:

    # n "雨，终于停了。"
    n "The rain, at last, has stopped."

# game/chapters/ch4_ending.rpy:87
translate english ending_peace_1521a7f4:

    # n "我端着酒杯，回到吧台后面。"
    n "I take my glass back behind the bar."

# game/chapters/ch4_ending.rpy:88
translate english ending_peace_107af5e1:

    # n "我把那只擦了一半的杯子，重新拿起来，慢慢地，擦完了。"
    n "I pick up the half-polished glass again and finish it, slowly."

# game/chapters/ch4_ending.rpy:90
translate english ending_peace_fff5ae4f:

    # mono "（一个环。)"
    mono "(A loop.)"

# game/chapters/ch4_ending.rpy:91
translate english ending_peace_ac9b3e1d:

    # mono "（是啊。一个环。)"
    mono "(Yes. A loop.)"

# game/chapters/ch4_ending.rpy:92
translate english ending_peace_aa345444:

    # mono "（可是你知道吗——)"
    mono "(But you know what —)"

# game/chapters/ch4_ending.rpy:93
translate english ending_peace_d0f34bc0:

    # mono "（环，也是「圆」啊。)"
    mono "(a loop is also a circle.)"

# game/chapters/ch4_ending.rpy:95
translate english ending_peace_d0b24d7a:

    # n "我笑了。"
    n "I smile."

# game/chapters/ch4_ending.rpy:96
translate english ending_peace_62e89fe9:

    # n "这是我今晚，第一次，真正地笑。"
    n "It's the first real smile I've had all night."

# game/chapters/ch4_ending.rpy:98
translate english ending_peace_bd7fbe60:

    # mono "（我遗弃了我自己。)"
    mono "(I abandoned myself.)"

# game/chapters/ch4_ending.rpy:99
translate english ending_peace_111d7bfd:

    # mono "（所以，我给了我自己，一个开始。)"
    mono "(So I gave myself a beginning.)"

# game/chapters/ch4_ending.rpy:100
translate english ending_peace_ef2ab360:

    # mono "（我抛弃了我自己。)"
    mono "(I deserted myself.)"

# game/chapters/ch4_ending.rpy:101
translate english ending_peace_4a60bade:

    # mono "（所以，我教会了我自己，什么是爱，什么是痛。)"
    mono "(So I taught myself what love is, and what pain is.)"

# game/chapters/ch4_ending.rpy:102
translate english ending_peace_577ec1d1:

    # mono "（我剖开了我自己。)"
    mono "(I cut myself open.)"

# game/chapters/ch4_ending.rpy:103
translate english ending_peace_7b688340:

    # mono "（所以，我让我自己，活了下来。)"
    mono "(So I let myself live.)"

# game/chapters/ch4_ending.rpy:105
translate english ending_peace_3e25101a:

    # n "我把酒杯举起来，对着空无一人的酒吧，轻轻碰了一下。"
    n "I raise the glass to the empty bar and clink it, lightly, against the air."

# game/chapters/ch4_ending.rpy:106
translate english ending_peace_da17dd2f:

    # n "像，和自己干杯。"
    n "Like toasting myself."

# game/chapters/ch4_ending.rpy:108
translate english ending_peace_a7d60b77:

    # mono "（别人的一生，是一条线。)"
    mono "(Other people's lives are a line.)"

# game/chapters/ch4_ending.rpy:109
translate english ending_peace_f8700c3d:

    # mono "（从别人来，到别人去。)"
    mono "(From others, toward others.)"

# game/chapters/ch4_ending.rpy:110
translate english ending_peace_0c50e167:

    # mono "（我的一生，是一个圆。)"
    mono "(My life is a circle.)"

# game/chapters/ch4_ending.rpy:111
translate english ending_peace_ef724f3e:

    # mono "（从我来，到我回。)"
    mono "(From me, back to me.)"

# game/chapters/ch4_ending.rpy:112
translate english ending_peace_9380ef41:

    # mono "（我没有家。)"
    mono "(I have no home.)"

# game/chapters/ch4_ending.rpy:113
translate english ending_peace_34410743:

    # mono "（可是，我就是我自己的家。)"
    mono "(But I am my own home.)"

# game/chapters/ch4_ending.rpy:115
translate english ending_peace_6822ea07:

    # n "窗外的天，泛起一点灰白。"
    n "Outside, the sky is going grey-white."

# game/chapters/ch4_ending.rpy:116
translate english ending_peace_7e3b8b6c:

    # n "雨停了。"
    n "The rain has stopped."

# game/chapters/ch4_ending.rpy:117
translate english ending_peace_6b1f13b5:

    # n "我哼起一支不成调的曲子，开始擦第二只杯子。"
    n "I hum something without a tune and start polishing a second glass."

# game/chapters/ch4_ending.rpy:119
translate english ending_peace_76ff64de:

    # mono "（晚安，简。)"
    mono "(Goodnight, Jane.)"

# game/chapters/ch4_ending.rpy:120
translate english ending_peace_5c9a09f7:

    # mono "（晚安，约翰。)"
    mono "(Goodnight, John.)"

# game/chapters/ch4_ending.rpy:121
translate english ending_peace_740ab54f:

    # mono "（晚安，我。)"
    mono "(Goodnight, me.)"

# game/chapters/ch4_ending.rpy:122
translate english ending_peace_1808ef87:

    # mono "（我们，明天见。)"
    mono "(See you tomorrow.)"

# game/chapters/ch4_ending.rpy:135
translate english ending_vertigo_191a254b:

    # n "我端着酒杯，站在吧台中间。"
    n "I stand in the middle of the bar, glass in hand."

# game/chapters/ch4_ending.rpy:136
translate english ending_vertigo_a43f8eae:

    # n "忽然，我觉得整个房间，轻轻地，转了一下。"
    n "All at once the whole room seems to turn, just slightly."

# game/chapters/ch4_ending.rpy:138
translate english ending_vertigo_fff5ae4f:

    # mono "（一个环。)"
    mono "(A loop.)"

# game/chapters/ch4_ending.rpy:139
translate english ending_vertigo_d474639e:

    # mono "（可是……环的起点，在哪里？)"
    mono "(But... where does the loop begin?)"

# game/chapters/ch4_ending.rpy:141
translate english ending_vertigo_e830ac24:

    # n "我走到镜子前面。"
    n "I walk to the mirror."

# game/chapters/ch4_ending.rpy:142
translate english ending_vertigo_586f9a3f:

    # n "镜子里，是我。"
    n "The person in it is me."

# game/chapters/ch4_ending.rpy:143
translate english ending_vertigo_5609974b:

    # n "可是有那么一瞬间，我看到的，不是「一个」我。"
    n "But for an instant, what I see isn't one me."

# game/chapters/ch4_ending.rpy:145
translate english ending_vertigo_0681568d:

    # n "是那个雪里的婴儿。是长椅上的少女。是手术台上的她。"
    n "It's the baby in the snow. The girl on the bench. Her on the table."

# game/chapters/ch4_ending.rpy:146
translate english ending_vertigo_a106ad3e:

    # n "是公园里的他。是写故事的他。是舱里的他。是老人。"
    n "Him in the park. Him writing his stories. Him in the pod. The old man."

# game/chapters/ch4_ending.rpy:147
translate english ending_vertigo_4d93fb02:

    # n "一层，一层，一层，叠在镜子里，全都看着我。"
    n "Layer on layer on layer, stacked in the glass, all looking at me."

# game/chapters/ch4_ending.rpy:149
translate english ending_vertigo_c0f40c4c:

    # mono "（到底，哪一个，才是「第一个」？)"
    mono "(Which one is the first?)"

# game/chapters/ch4_ending.rpy:150
translate english ending_vertigo_4f2c55ec:

    # mono "（是先有了婴儿，才有了我？)"
    mono "(Did the baby come first, and then me?)"

# game/chapters/ch4_ending.rpy:151
translate english ending_vertigo_cbd69305:

    # mono "（还是先有了我，才……放回了婴儿？)"
    mono "(Or did I come first, and... put the baby back?)"

# game/chapters/ch4_ending.rpy:152
translate english ending_vertigo_1a81c10f:

    # mono "（鸡生蛋，蛋生鸡。)"
    mono "(The chicken and the egg.)"

# game/chapters/ch4_ending.rpy:153
translate english ending_vertigo_d4cc52ca:

    # mono "（可如果，鸡和蛋，是同一个东西呢？)"
    mono "(But what if the chicken and the egg are the same thing?)"

# game/chapters/ch4_ending.rpy:155
translate english ending_vertigo_eb44e652:

    # n "我伸出手，碰了碰镜子。"
    n "I reach out and touch the mirror."

# game/chapters/ch4_ending.rpy:156
translate english ending_vertigo_b54b44f1:

    # n "镜面冰凉。"
    n "The glass is cold."

# game/chapters/ch4_ending.rpy:158
translate english ending_vertigo_f78f518a:

    # mono "（我是谁？)"
    mono "(Who am I?)"

# game/chapters/ch4_ending.rpy:159
translate english ending_vertigo_a9457d26:

    # mono "（这个问题，别人用一生来问。)"
    mono "(Other people spend a lifetime asking that.)"

# game/chapters/ch4_ending.rpy:160
translate english ending_vertigo_43e1715a:

    # mono "（而我，问出来的答案，是一个「所有人」。)"
    mono "(And the answer I come up with is \"everyone.\")"

# game/chapters/ch4_ending.rpy:161
translate english ending_vertigo_039b665b:

    # mono "（也等于，一个「没有人」。)"
    mono "(Which is the same as \"no one.\")"

# game/chapters/ch4_ending.rpy:163
translate english ending_vertigo_15366b40:

    # n "我转过头，看向空荡荡的酒吧，看向门外湿漉漉的、空无一人的街。"
    n "I turn and look at the empty bar, at the wet, empty street beyond the door."

# game/chapters/ch4_ending.rpy:164
translate english ending_vertigo_c4fdc823:

    # n "我忽然很想问一句——"
    n "Suddenly I want to ask —"

# game/chapters/ch4_ending.rpy:166
translate english ending_vertigo_fae2cc9e:

    # mono "（我知道，我从哪里来。)"
    mono "(I know where I came from.)"

# game/chapters/ch4_ending.rpy:167
translate english ending_vertigo_ea07d4bc:

    # mono "（我从我自己来。)"
    mono "(I came from me.)"

# game/chapters/ch4_ending.rpy:168
translate english ending_vertigo_0556ed5f:

    # mono "（可是——)"
    mono "(But —)"

# game/chapters/ch4_ending.rpy:169
translate english ending_vertigo_1e0f5afc:

    # mono "（你们呢？)"
    mono "(what about you?)"

# game/chapters/ch4_ending.rpy:170
translate english ending_vertigo_c23fb583:

    # mono "（你们这些，有爸爸、有妈妈、有来处的「人」——)"
    mono "(You people with fathers and mothers and somewhere to come from —)"

# game/chapters/ch4_ending.rpy:171
translate english ending_vertigo_ce375794:

    # mono "（你们这些……僵尸。)"
    mono "(you... zombies.)"

# game/chapters/ch4_ending.rpy:172
translate english ending_vertigo_a3044b8a:

    # mono "（你们，又是从哪里来的？)"
    mono "(Where do you come from?)"

# game/chapters/ch4_ending.rpy:174
translate english ending_vertigo_2b22a301:

    # n "没有人回答我。"
    n "No one answers."

# game/chapters/ch4_ending.rpy:175
translate english ending_vertigo_bd5ba339:

    # n "只有雨，又开始下了。"
    n "Only the rain, starting up again."

# game/chapters/ch4_ending.rpy:188
translate english ending_epiphany_ca522da9:

    # n "我端着酒杯，站在吧台后面。"
    n "I stand behind the bar, glass in hand."

# game/chapters/ch4_ending.rpy:189
translate english ending_epiphany_d06e2542:

    # n "奇怪的是，我的心里，同时翻涌着三种东西。"
    n "Strangely, three things are rising in me all at once."

# game/chapters/ch4_ending.rpy:191
translate english ending_epiphany_440a4824:

    # mono "（我恨这个环。恨得想把一切都砸碎。)"
    mono "(I hate this loop — hate it enough to smash it all to pieces.)"

# game/chapters/ch4_ending.rpy:192
translate english ending_epiphany_3adaf1f4:

    # mono "（我爱这个环。爱得想把它抱进怀里。)"
    mono "(I love this loop — love it enough to hold it close.)"

# game/chapters/ch4_ending.rpy:193
translate english ending_epiphany_493018d0:

    # mono "（我怕这个环。怕得连「我」是谁，都不敢确定。)"
    mono "(I fear this loop — fear it so much I daren't be sure who \"I\" even am.)"

# game/chapters/ch4_ending.rpy:195
translate english ending_epiphany_8f3df50f:

    # n "恨，爱，怕。"
    n "Hate, love, fear."

# game/chapters/ch4_ending.rpy:196
translate english ending_epiphany_dadd94f9:

    # n "它们在我身体里，打了很久，很久。"
    n "They fight inside me for a long, long time."

# game/chapters/ch4_ending.rpy:197
translate english ending_epiphany_278af428:

    # n "然后，忽然之间——"
    n "And then, all at once —"

# game/chapters/ch4_ending.rpy:198
translate english ending_epiphany_6c24ed76:

    # n "它们，安静了。"
    n "they go quiet."

# game/chapters/ch4_ending.rpy:200
translate english ending_epiphany_001a4db4:

    # n "不是消失了。"
    n "Not gone."

# game/chapters/ch4_ending.rpy:201
translate english ending_epiphany_be6fd1bb:

    # n "是它们终于明白，它们，也是同一个东西。"
    n "They've simply understood, at last, that they too are the same thing."

# game/chapters/ch4_ending.rpy:206
translate english ending_epiphany_263fe395:

    # mono "（蛇，咬住了自己的尾巴。)"
    mono "(The snake bites its own tail.)"

# game/chapters/ch4_ending.rpy:207
translate english ending_epiphany_c0cd7c98:

    # mono "（人们说，那是囚笼。)"
    mono "(People call that a prison.)"

# game/chapters/ch4_ending.rpy:208
translate english ending_epiphany_65ed4063:

    # mono "（可是你看——)"
    mono "(But look —)"

# game/chapters/ch4_ending.rpy:209
translate english ending_epiphany_66967658:

    # mono "（当蛇，心甘情愿地，咬住自己的那一刻——)"
    mono "(the moment the snake bites down, willingly —)"

# game/chapters/ch4_ending.rpy:210
translate english ending_epiphany_34dac085:

    # mono "（囚笼，就变成了光环。)"
    mono "(the prison becomes a halo.)"

# game/chapters/ch4_ending.rpy:212
translate english ending_epiphany_a27b698a:

    # n "我看见了。"
    n "I see it."

# game/chapters/ch4_ending.rpy:213
translate english ending_epiphany_c17f7296:

    # n "在酒杯晃动的光里，我看见了「我们」。"
    n "In the light trembling in the glass, I see \"us.\""

# game/chapters/ch4_ending.rpy:214
translate english ending_epiphany_4e8ab8e0:

    # n "婴儿，少女，他，我，老人。"
    n "Baby, girl, him, me, the old man."

# game/chapters/ch4_ending.rpy:215
translate english ending_epiphany_ca2f451d:

    # n "我们站成一个圈，手拉着手。"
    n "We stand in a circle, hand in hand."

# game/chapters/ch4_ending.rpy:216
translate english ending_epiphany_36e637e2:

    # n "每一张脸上，都有泪。"
    n "Every face is in tears."

# game/chapters/ch4_ending.rpy:217
translate english ending_epiphany_7a7eac11:

    # n "可是每一张脸上，也都在笑。"
    n "And every face is smiling."

# game/chapters/ch4_ending.rpy:219
translate english ending_epiphany_e7c9f3a6:

    # mono "（我不是被困在环里的人。)"
    mono "(I'm not the one trapped in the loop.)"

# game/chapters/ch4_ending.rpy:220
translate english ending_epiphany_1d5e2c15:

    # mono "（我，就是环本身。)"
    mono "(I am the loop.)"

# game/chapters/ch4_ending.rpy:221
translate english ending_epiphany_99b1c2ea:

    # mono "（我不是在重复我的一生。)"
    mono "(I'm not repeating my life.)"

# game/chapters/ch4_ending.rpy:222
translate english ending_epiphany_8e236573:

    # mono "（我的一生，就是「重复」本身。)"
    mono "(My life is repetition itself.)"

# game/chapters/ch4_ending.rpy:223
translate english ending_epiphany_41d38507:

    # mono "（而这，不是诅咒。)"
    mono "(And that isn't a curse.)"

# game/chapters/ch4_ending.rpy:224
translate english ending_epiphany_2d070fbc:

    # mono "（这是……圆满。)"
    mono "(It's... completion.)"

# game/chapters/ch4_ending.rpy:226
translate english ending_epiphany_f3e3ea0c:

    # n "我举起酒杯。"
    n "I raise the glass."

# game/chapters/ch4_ending.rpy:227
translate english ending_epiphany_f2a16c38:

    # n "这一次，我不是和自己干杯。"
    n "This time I'm not toasting myself alone."

# game/chapters/ch4_ending.rpy:228
translate english ending_epiphany_2d0649a1:

    # n "我是和「我们」，所有人，干杯。"
    n "I'm toasting all of us."

# game/chapters/ch4_ending.rpy:230
translate english ending_epiphany_fa3bcbba:

    # bart "敬，我自己。"
    bart "To me."

# game/chapters/ch4_ending.rpy:231
translate english ending_epiphany_fe515b55:

    # bart "敬，你们，所有的我。"
    bart "To all of you — every one of me."

# game/chapters/ch4_ending.rpy:232
translate english ending_epiphany_111ca0dc:

    # bart "敬，这条，首尾相衔的——"
    bart "To this perfect, tail-swallowing —"

# game/chapters/ch4_ending.rpy:233
translate english ending_epiphany_733ea7cc:

    # bart "完美的蛇。"
    bart "snake."

# game/chapters/ch4_ending.rpy:235
translate english ending_epiphany_2b2b123a:

    # n "我把酒，一饮而尽。"
    n "I drink it down."

# game/chapters/ch4_ending.rpy:237
translate english ending_epiphany_78084510:

    # mono "（可是，故事还没有结束。)"
    mono "(But the story isn't over.)"

# game/chapters/ch4_ending.rpy:238
translate english ending_epiphany_f4ca14ee:

    # mono "（我的故事，从来，就没有结束过。)"
    mono "(My story has never been over.)"

# game/chapters/ch4_ending.rpy:239
translate english ending_epiphany_bd3f4d89:

    # mono "（还有最后一段路。)"
    mono "(There's one last stretch of road.)"

# game/chapters/ch4_ending.rpy:240
translate english ending_epiphany_2f4b8b87:

    # mono "（那段，我最不愿走，却终究要走完的路。)"
    mono "(The one I least want to walk — and yet must walk to the end.)"

# game/chapters/ch4_ending.rpy:250
translate english ending_epiphany_9c347287:

    # n "1993年。"
    n "1993."

# game/chapters/ch4_ending.rpy:251
translate english ending_epiphany_79a2f453:

    # n "一间不大的房间。窗外，是暮色。"
    n "A small room. Outside the window, dusk."

# game/chapters/ch4_ending.rpy:252
translate english ending_epiphany_a706643c:

    # n "金色的、疲惫的光，落在旧地板上。"
    n "A gold, weary light falling on the old floorboards."

# game/chapters/ch4_ending.rpy:254
translate english ending_epiphany_76c3b8c1:

    # n "我老了。"
    n "I'm old now."

# game/chapters/ch4_ending.rpy:255
translate english ending_epiphany_6aa7fd85:

    # n "今天，我做完了最后一件事——"
    n "Today I finished the last thing there is to do —"

# game/chapters/ch4_ending.rpy:256
translate english ending_epiphany_fd983c83:

    # n "把那个年轻人，招进了时间局。"
    n "I recruited that young man into the Temporal Bureau."

# game/chapters/ch4_ending.rpy:257
translate english ending_epiphany_b6d7e491:

    # n "把「我」，交给了「我」。"
    n "Handed \"me\" over to \"me.\""

# game/chapters/ch4_ending.rpy:258
translate english ending_epiphany_6e32d204:

    # n "现在，这条蛇，真正地，咬住了它的尾巴。"
    n "Now the snake has truly closed its jaws on its tail."

# game/chapters/ch4_ending.rpy:260
translate english ending_epiphany_90910638:

    # n "我站在床边，开始换衣服。"
    n "I stand by the bed and start to change."

# game/chapters/ch4_ending.rpy:261
translate english ending_epiphany_2438df63:

    # n "解开衬衫的扣子。一颗。又一颗。"
    n "Undoing the buttons of my shirt. One. Then another."

# game/chapters/ch4_ending.rpy:266
translate english ending_epiphany_e3467cd3:

    # n "然后，我又看见了它。"
    n "And then I see it again."

# game/chapters/ch4_ending.rpy:267
translate english ending_epiphany_4a976849:

    # n "肚子上，那道疤。"
    n "The scar on my belly."

# game/chapters/ch4_ending.rpy:268
translate english ending_epiphany_edfaba37:

    # n "剖腹产留下的。"
    n "From the cesarean."

# game/chapters/ch4_ending.rpy:269
translate english ending_epiphany_c89cb39f:

    # n "几十年了，它还在那里。"
    n "Decades on, and it's still there."

# game/chapters/ch4_ending.rpy:270
translate english ending_epiphany_85ded6be:

    # n "像一张，永远不会愈合的嘴。"
    n "Like a mouth that will never heal."

# game/chapters/ch4_ending.rpy:272
translate english ending_epiphany_20e2522e:

    # n "我用手指，轻轻地，摸了摸它。"
    n "I touch it, lightly, with my fingertips."

# game/chapters/ch4_ending.rpy:274
translate english ending_epiphany_242b0a64:

    # mono "（这是「她」留给我的。)"
    mono "(This is what \"she\" left me.)"

# game/chapters/ch4_ending.rpy:275
translate english ending_epiphany_addcca0e:

    # mono "（简，留给我最后的，一样东西。)"
    mono "(The last thing Jane ever left me.)"

# game/chapters/ch4_ending.rpy:277
translate english ending_epiphany_aae0fb15:

    # n "我坐下来。暮色，越来越深。"
    n "I sit down. The dusk deepens."

# game/chapters/ch4_ending.rpy:278
translate english ending_epiphany_635806f1:

    # n "我望着窗外，望着这个，我自己一个人，活了一辈子的世界。"
    n "I look out at the world I've lived in, alone, my whole life."

# game/chapters/ch4_ending.rpy:279
translate english ending_epiphany_c403f6f1:

    # n "忽然，我想说点什么。"
    n "And suddenly I want to say something."

# game/chapters/ch4_ending.rpy:280
translate english ending_epiphany_6067c108:

    # n "对着这间空屋子。对着暮色。对着……所有不在这里的人。"
    n "To the empty room. To the dusk. To... everyone who isn't here."

# game/chapters/ch4_ending.rpy:282
translate english ending_epiphany_7a88a1a9:

    # bart "蛇，吞吃了它自己的尾巴。"
    bart "The snake swallows its own tail."

# game/chapters/ch4_ending.rpy:283
translate english ending_epiphany_39914b29:

    # bart "一圈，又一圈。"
    bart "Round and round."

# game/chapters/ch4_ending.rpy:284
translate english ending_epiphany_14673ed7:

    # bart "周而复始。"
    bart "Again, and again."

# game/chapters/ch4_ending.rpy:285
translate english ending_epiphany_1947b473:

    # bart "……何谓始？何谓终？"
    bart "...Where's the beginning? Where's the end?"

# game/chapters/ch4_ending.rpy:287
translate english ending_epiphany_48ee7561:

    # n "我笑了一下。"
    n "I smile, a little."

# game/chapters/ch4_ending.rpy:289
translate english ending_epiphany_c2d2ffc9:

    # bart "我终于知道，我是从哪里来的了。"
    bart "At last I know where I came from."

# game/chapters/ch4_ending.rpy:290
translate english ending_epiphany_4bbd1635:

    # bart "我从，我自己来。"
    bart "I came from me."

# game/chapters/ch4_ending.rpy:291
translate english ending_epiphany_0e8b3976:

    # bart "可是你们呢？"
    bart "But you — what about you?"

# game/chapters/ch4_ending.rpy:292
translate english ending_epiphany_3ac4f84d:

    # n "我抬起头，望向那片越来越暗的天。"
    n "I lift my head to the darkening sky."

# game/chapters/ch4_ending.rpy:293
translate english ending_epiphany_86164cdb:

    # bart "你们这些……回魂尸。"
    bart "All you... zombies."

# game/chapters/ch4_ending.rpy:294
translate english ending_epiphany_1c5e896b:

    # bart "你们，又是从哪里来的呢？"
    bart "Where do you come from?"

# game/chapters/ch4_ending.rpy:296
translate english ending_epiphany_6623fe5e:

    # n "没有人回答。"
    n "No one answers."

# game/chapters/ch4_ending.rpy:297
translate english ending_epiphany_435b94df:

    # n "从来，就没有人回答。"
    n "No one ever does."

# game/chapters/ch4_ending.rpy:299
translate english ending_epiphany_6ff83fef:

    # n "太阳穴，忽然一阵刺痛。"
    n "A stab of pain at my temples."

# game/chapters/ch4_ending.rpy:300
translate english ending_epiphany_40992a6d:

    # n "又来了。"
    n "Again."

# game/chapters/ch4_ending.rpy:302
translate english ending_epiphany_f6c38641:

    # mono "（抽屉里，有头痛药粉。)"
    mono "(There's headache powder in the drawer.)"

# game/chapters/ch4_ending.rpy:303
translate english ending_epiphany_b6137444:

    # mono "（但我没有去拿。)"
    mono "(But I don't reach for it.)"

# game/chapters/ch4_ending.rpy:304
translate english ending_epiphany_fbd1a34b:

    # mono "（我从来，不吃那东西。)"
    mono "(I never take the stuff.)"

# game/chapters/ch4_ending.rpy:306
translate english ending_epiphany_cf13d8f9:

    # n "我掀开被子，钻了进去。"
    n "I pull back the covers and get in."

# game/chapters/ch4_ending.rpy:307
translate english ending_epiphany_445f1c60:

    # n "床很凉。"
    n "The bed is cold."

# game/chapters/ch4_ending.rpy:308
translate english ending_epiphany_f84c4d2f:

    # n "我吹了一声口哨。"
    n "I whistle, once."

# game/chapters/ch4_ending.rpy:310
translate english ending_epiphany_8a3f228a:

    # n "灯，灭了。"
    n "The light goes out."

# game/chapters/ch4_ending.rpy:315
translate english ending_epiphany_b1b8f01e:

    # n "……"
    n "..."

# game/chapters/ch4_ending.rpy:317
translate english ending_epiphany_99a21fa2:

    # n "黑暗里，什么都没有。"
    n "In the dark, there's nothing."

# game/chapters/ch4_ending.rpy:319
translate english ending_epiphany_767e2c94:

    # n "你，根本就不在那里。"
    n "You were never there."

# game/chapters/ch4_ending.rpy:320
translate english ending_epiphany_8103c358:

    # n "从来，都不在。"
    n "You never were."

# game/chapters/ch4_ending.rpy:322
translate english ending_epiphany_f966139d:

    # n "这里没有别人。"
    n "There's no one else here."

# game/chapters/ch4_ending.rpy:323
translate english ending_epiphany_de6d8aec:

    # n "只有我。"
    n "Only me."

# game/chapters/ch4_ending.rpy:325
translate english ending_epiphany_1261f846:

    # n "是简。"
    n "It's Jane."

# game/chapters/ch4_ending.rpy:326
translate english ending_epiphany_87bf3041:

    # n "孤零零地，待在这片黑暗里。"
    n "Alone, here in the dark."

# game/chapters/ch4_ending.rpy:328
translate english ending_epiphany_da131049:

    # n "……我，真想你。"
    n "...I miss you so much."

# game/chapters/ch4_ending.rpy:341
translate english credits_374d385e:

    # n "《你们这些还魂尸》"
    n "\"All You Zombies\""

# game/chapters/ch4_ending.rpy:342
translate english credits_4ba1238d:

    # n "—— 一部基于罗伯特·海因莱因同名小说的原创同人改编视觉小说 ——"
    n "— An original fan-adaptation visual novel based on Robert A. Heinlein's story of the same name —"

# game/chapters/ch4_ending.rpy:343
translate english credits_9445cbf5:

    # n "非商业作品，谨向原作致敬。"
    n "A non-commercial work, made in tribute to the original."

# game/chapters/ch4_ending.rpy:349
translate english credits_73930c01:

    # n "【彩蛋】你集齐了全部七条线索。"
    n "[Bonus] You collected all seven clues."

# game/chapters/ch4_ending.rpy:350
translate english credits_f6f09359:

    # n "现在你知道了——从第一眼起，你就认出了他。"
    n "Now you know — from the very first glance, you recognized him."

# game/chapters/ch4_ending.rpy:351
translate english credits_fb957be6:

    # n "因为，你一直都在照镜子。"
    n "Because you've been looking into a mirror all along."
