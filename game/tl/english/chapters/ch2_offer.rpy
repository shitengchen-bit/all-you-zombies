# TODO: Translation updated at 2026-07-22 02:09

# game/chapters/ch2_offer.rpy:10
translate english act2_offer_eccf694d:

    # n "五个故事，讲完了。"
    n "Five stories, told."

# game/chapters/ch2_offer.rpy:11
translate english act2_offer_02e96952:

    # n "酒吧里安静下来。只剩下雨，和钟。"
    n "The bar goes quiet. Only the rain, and the clock."

# game/chapters/ch2_offer.rpy:13
translate english act2_offer_24966fa0:

    # john "好了，酒保。你听完了。"
    john "Well, bartender. You've heard it."

# game/chapters/ch2_offer.rpy:14
translate english act2_offer_329cc54d:

    # n "他把空杯子转了个圈。"
    n "He turns the empty glass in a circle."

# game/chapters/ch2_offer.rpy:15
translate english act2_offer_c5bba9aa:

    # john "现在你知道了。我就是这么个……东西。"
    john "Now you know. I'm just... this thing."

# game/chapters/ch2_offer.rpy:16
translate english act2_offer_a2644210:

    # john "一个笑话。一个连上帝写剧本时，都写崩了的笑话。"
    john "A joke. A joke even God botched when he was writing the script."

# game/chapters/ch2_offer.rpy:18
translate english act2_offer_bf700729:

    # mono "（不。不是笑话。)"
    mono "(No. Not a joke.)"

# game/chapters/ch2_offer.rpy:19
translate english act2_offer_a3252775:

    # mono "（我看着他，心口那种闷闷的疼，又来了。)"
    mono "(I look at him, and that dull ache is back in my chest.)"

# game/chapters/ch2_offer.rpy:20
translate english act2_offer_954f33b5:

    # mono "（我好像……认识他。认识了一辈子。)"
    mono "(I feel like... I know him. Have known him my whole life.)"

# game/chapters/ch2_offer.rpy:21
translate english act2_offer_32578166:

    # mono "（不。比一辈子，还要久。)"
    mono "(No. Longer than a lifetime.)"

# game/chapters/ch2_offer.rpy:22
translate english act2_offer_b1c092d3:

    # mono "（可这到底是怎么回事……连我自己，也说不清。)"
    mono "(But what that means... even I can't say.)"

# game/chapters/ch2_offer.rpy:24
translate english act2_offer_ce60e9dc:

    # n "我放下擦杯子的布。"
    n "I set down the rag."

# game/chapters/ch2_offer.rpy:25
translate english act2_offer_ab3f93a3:

    # n "是时候了。"
    n "It's time."

# game/chapters/ch2_offer.rpy:27
translate english act2_offer_9de921b8:

    # bart "如果——"
    bart "What if—"

# game/chapters/ch2_offer.rpy:28
translate english act2_offer_1e502907:

    # n "我开口。他抬起头。"
    n "I begin. He looks up."

# game/chapters/ch2_offer.rpy:29
translate english act2_offer_d16e4a22:

    # bart "如果我能让你回去呢？"
    bart "What if I could send you back?"

# game/chapters/ch2_offer.rpy:31
translate english act2_offer_2ed65ac0:

    # john "……什么？"
    john "...What?"

# game/chapters/ch2_offer.rpy:33
translate english act2_offer_134c0a6d:

    # bart "回到1963年。回到那个公园。"
    bart "Back to 1963. Back to that park."

# game/chapters/ch2_offer.rpy:34
translate english act2_offer_c36e9bc9:

    # bart "回到……他消失的那个晚上。"
    bart "Back to the night he disappeared."

# game/chapters/ch2_offer.rpy:35
translate english act2_offer_de14c4cf:

    # bart "你可以站在他面前。你可以问他为什么。"
    bart "You could stand in front of him. You could ask him why."

# game/chapters/ch2_offer.rpy:36
translate english act2_offer_49cb89ca:

    # bart "你甚至可以——"
    bart "You could even—"

# game/chapters/ch2_offer.rpy:37
translate english act2_offer_5e41f85d:

    # n "我顿了顿。"
    n "I pause."

# game/chapters/ch2_offer.rpy:38
translate english act2_offer_75e1a7cf:

    # bart "——亲手揍他一顿。"
    bart "—beat the hell out of him."

# game/chapters/ch2_offer.rpy:40
translate english act2_offer_708c2246:

    # n "他盯着我，像在看一个疯子。"
    n "He stares at me like I'm insane."

# game/chapters/ch2_offer.rpy:41
translate english act2_offer_2df8e787:

    # john "你喝多了。"
    john "You've had too much."

# game/chapters/ch2_offer.rpy:42
translate english act2_offer_9e5679a0:

    # john "时间不能倒流。谁都他妈知道，时间不能倒流。"
    john "Time doesn't run backward. Everyone knows that."

# game/chapters/ch2_offer.rpy:45
translate english act2_offer_b636431f:

    # bart "……" nointeract
    bart "..." nointeract

# game/chapters/ch2_offer.rpy:49
translate english act2_offer_f68ea589:

    # john "时间……局？"
    john "The Temporal... Bureau?"

# game/chapters/ch2_offer.rpy:50
translate english act2_offer_6f33a290:

    # n "他笑出了声，但笑声在半路就断了。"
    n "He laughs out loud, but the laugh dies halfway."

# game/chapters/ch2_offer.rpy:51
translate english act2_offer_252937bc:

    # n "因为我的表情，一点都没有在开玩笑。"
    n "Because my face isn't joking at all."

# game/chapters/ch2_offer.rpy:55
translate english act2_offer_5df9b5ec:

    # n "这句话像针一样。他僵住了。"
    n "The words hit like a needle. He goes rigid."

# game/chapters/ch2_offer.rpy:56
translate english act2_offer_4d026005:

    # john "……"
    john "..."

# game/chapters/ch2_offer.rpy:57
translate english act2_offer_a6ebfbeb:

    # john "是啊。我什么都没有了。"
    john "Yeah. I've got nothing left."

# game/chapters/ch2_offer.rpy:58
translate english act2_offer_993c1aab:

    # john "连「不信」，都显得奢侈。"
    john "Even 'not believing' feels like a luxury."

# game/chapters/ch2_offer.rpy:63
translate english act2_offer_55ac19d8:

    # n "他看着我，看了很久。"
    n "He looks at me for a long time."

# game/chapters/ch2_offer.rpy:64
translate english act2_offer_0580ed4b:

    # john "……你这个人，真的很奇怪。"
    john "...You're a really strange person."

# game/chapters/ch2_offer.rpy:65
translate english act2_offer_cd3553f3:

    # john "奇怪得，让我没法拒绝。"
    john "Strange enough that I can't say no."

# game/chapters/ch2_offer.rpy:67
translate english act2_offer_e1f3b09b:

    # john "……好。"
    john "...Fine."

# game/chapters/ch2_offer.rpy:68
translate english act2_offer_ea8ee09d:

    # n "他站起来，摇摇晃晃。"
    n "He stands, unsteady."

# game/chapters/ch2_offer.rpy:69
translate english act2_offer_1a7dd536:

    # john "带我去。让我看看，你到底是疯子，还是……"
    john "Take me. Let's see if you're a lunatic, or..."

# game/chapters/ch2_offer.rpy:70
translate english act2_offer_215d442a:

    # john "还是我这辈子，遇到的第二个「懂我」的人。"
    john "...or the second person in my life who actually gets me."

# game/chapters/ch2_offer.rpy:72
translate english act2_offer_78190566:

    # mono "（第二个。)"
    mono "(The second.)"

# game/chapters/ch2_offer.rpy:73
translate english act2_offer_ec015c6f:

    # mono "（不。是第一个。)"
    mono "(No. The first.)"

# game/chapters/ch2_offer.rpy:74
translate english act2_offer_c811861f:

    # mono "（一直都是第一个。)"
    mono "(Always the first.)"

# game/chapters/ch2_offer.rpy:81
translate english act2_offer_e7c8f658:

    # n "酒吧的后门，通向一条我从未带他走过的走廊。"
    n "The back door of the bar opens onto a corridor I've never shown him."

# game/chapters/ch2_offer.rpy:82
translate english act2_offer_fba25f08:

    # n "走廊尽头，是一间……不属于这个时代的房间。"
    n "At the end of it is a room that doesn't belong to this era."

# game/chapters/ch2_offer.rpy:84
translate english act2_offer_13695be0:

    # n "金属。仪表盘。缠绕的线缆。"
    n "Metal. Instrument panels. Coiled cables."

# game/chapters/ch2_offer.rpy:85
translate english act2_offer_64d82e97:

    # n "房间中央，立着一个舱。"
    n "In the center stands a pod."

# game/chapters/ch2_offer.rpy:86
translate english act2_offer_eae43286:

    # n "它看起来像一口竖起来的棺材，又像一个巨大的、金属的蛹。"
    n "It looks like a coffin stood on end, or an enormous metal chrysalis."

# game/chapters/ch2_offer.rpy:88
translate english act2_offer_fe68725d:

    # john "这……这是什么？"
    john "What... is that?"

# game/chapters/ch2_offer.rpy:90
translate english act2_offer_0fb3926c:

    # bureau "时间舱。型号很老了，但还能用。"
    bureau "A time pod. Old model, but it still works."

# game/chapters/ch2_offer.rpy:91
translate english act2_offer_1b6e1800:

    # n "一个声音从阴影里传来。不是我的。"
    n "A voice comes out of the shadows. Not mine."

# game/chapters/ch2_offer.rpy:92
translate english act2_offer_25c92e1f:

    # n "是「局里」的声音。他们一直在听。"
    n "The Bureau's. They've been listening."

# game/chapters/ch2_offer.rpy:94
translate english act2_offer_fd92061f:

    # bureau "目的地：1963年4月。误差，正负三天。"
    bureau "Destination: April, 1963. Margin of error, three days either way."

# game/chapters/ch2_offer.rpy:95
translate english act2_offer_23fb1e0b:

    # bureau "规则只有一条——"
    bureau "One rule —"

# game/chapters/ch2_offer.rpy:96
translate english act2_offer_983f2d0f:

    # bureau "你可以看，可以问，可以打他。"
    bureau "You can look, you can ask, you can hit him."

# game/chapters/ch2_offer.rpy:97
translate english act2_offer_623af3b9:

    # bureau "但你不能改变「结果」。"
    bureau "But you cannot change the outcome."

# game/chapters/ch2_offer.rpy:99
translate english act2_offer_911b25e3:

    # john "为什么？"
    john "Why not?"

# game/chapters/ch2_offer.rpy:101
translate english act2_offer_a8d9be56:

    # bureau "因为结果，已经发生了。"
    bureau "Because the outcome has already happened."

# game/chapters/ch2_offer.rpy:102
translate english act2_offer_9b139b60:

    # bureau "你此刻站在这里，就是「结果」的一部分。"
    bureau "You standing here right now is part of it."

# game/chapters/ch2_offer.rpy:104
translate english act2_offer_8c6db6ce:

    # mono "（他以为，他是回去「改变」什么的人。)"
    mono "(He thinks he's going back to change something.)"

# game/chapters/ch2_offer.rpy:105
translate english act2_offer_2024115a:

    # mono "（我张了张嘴，想告诉他些什么。)"
    mono "(I open my mouth to tell him something.)"

# game/chapters/ch2_offer.rpy:106
translate english act2_offer_01366383:

    # mono "（可我说不出口。因为连我自己……也还没完全弄明白，那究竟是什么。)"
    mono "(But I can't get it out. Because even I... haven't fully worked out what it is.)"

# game/chapters/ch2_offer.rpy:111
translate english act2_offer_53944217:

    # n "舱门打开了。里面透出幽蓝的光。"
    n "The pod opens. Blue light spills out."

# game/chapters/ch2_offer.rpy:112
translate english act2_offer_dddac8ea:

    # n "他站在舱门前，回头看了我一眼。"
    n "He stands at the hatch and looks back at me."

# game/chapters/ch2_offer.rpy:114
translate english act2_offer_8a5c998e:

    # john "你……不跟我一起？"
    john "You're... not coming?"

# game/chapters/ch2_offer.rpy:116
translate english act2_offer_b0df5980:

    # bart "我有我的部分。"
    bart "I've got my part."

# game/chapters/ch2_offer.rpy:117
translate english act2_offer_352b290a:

    # n "我说。"
    n "I say."

# game/chapters/ch2_offer.rpy:118
translate english act2_offer_42697a5b:

    # bart "你去做你的。我去做我的。"
    bart "You do yours. I'll do mine."

# game/chapters/ch2_offer.rpy:119
translate english act2_offer_5b26f446:

    # bart "我们……会在该碰头的地方碰头。"
    bart "We'll... meet where we're meant to meet."

# game/chapters/ch2_offer.rpy:121
translate english act2_offer_b740dc4a:

    # john "……什么鬼话。"
    john "...What the hell is that supposed to mean."

# game/chapters/ch2_offer.rpy:122
translate english act2_offer_812bac0c:

    # n "他骂了一句，但还是跨了进去。"
    n "He swears, but he steps in anyway."

# game/chapters/ch2_offer.rpy:124
translate english act2_offer_04c87be2:

    # n "舱门合拢。"
    n "The hatch closes."

# game/chapters/ch2_offer.rpy:125
translate english act2_offer_82f06ebc:

    # n "仪表盘亮起，一格，一格，又一格。"
    n "The panel lights up, one bar, then another."

# game/chapters/ch2_offer.rpy:126
translate english act2_offer_9e50cdd7:

    # n "嗡鸣声越来越大，像整个房间都在深呼吸。"
    n "The hum builds until the whole room seems to be breathing."

# game/chapters/ch2_offer.rpy:128
translate english act2_offer_d91d88b5:

    # mono "（去吧。)"
    mono "(Go.)"

# game/chapters/ch2_offer.rpy:129
translate english act2_offer_bd0de669:

    # mono "（去做……你不得不做的事。)"
    mono "(Do... what you have to do.)"

# game/chapters/ch2_offer.rpy:130
translate english act2_offer_4ad5927d:

    # mono "（我会在，我该在的地方，做我该做的事。)"
    mono "(I'll be where I'm meant to be, doing what I'm meant to do.)"

# game/chapters/ch2_offer.rpy:131
translate english act2_offer_d3e65590:

    # mono "（……我们，还会再见的。)"
    mono "(...We'll meet again.)"

# game/chapters/ch2_offer.rpy:132
translate english act2_offer_01ee4a85:

    # mono "（这个念头冒出来的时候，我自己都吓了一跳。)"
    mono "(The thought startles me when it surfaces.)"

# game/chapters/ch2_offer.rpy:133
translate english act2_offer_ed48cfbb:

    # mono "（可我莫名地，确信它是真的。)"
    mono "(And yet I'm certain, somehow, that it's true.)"

# game/chapters/ch2_offer.rpy:135
translate english act2_offer_73ad2f52:

    # n "白光吞没了舱，吞没了房间，吞没了一切。"
    n "White light swallows the pod, the room, everything."

translate english strings:

    # game/chapters/ch2_offer.rpy:47
    old "「我能。因为我是时间局的人。」"
    new "\"I can. Because I'm with the Temporal Bureau.\""

    # game/chapters/ch2_offer.rpy:53
    old "「信不信由你。但你已经没什么可失去的了。」"
    new "\"Believe it or not. But you've got nothing left to lose.\""

    # game/chapters/ch2_offer.rpy:60
    old "「就当是，陪我这个酒保疯一次。」"
    new "\"Just humor a crazy bartender, once.\""
