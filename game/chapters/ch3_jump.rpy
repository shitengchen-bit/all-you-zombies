# 第三幕：穿越 - ch3_jump.rpy
# 闭环揭示。时间漩涡。调色：抽象琥珀深蓝漩涡 + 各时代切换。

label act3_jump:

    # ----- 时间漩涡 -----
    scene bg time_vortex
    with dissolve
    play music "audio/bgm/time_vortex.wav"

    n "这里不是任何地方。"
    n "这里是「之间」。"

    n "琥珀色的光，拧成一股一股的漩涡，向深处旋转。"
    n "深蓝，焦赭，一圈一圈，像一条咬住自己尾巴的蛇。"

    # ----- 第七处线索：漩涡中剪影重叠 -----
    scene cg silhouettes
    with dissolve
    $ add_clue("clue_silhouette")

    n "漩涡里，浮着一些影子。"
    n "一个抱着襁褓的女人。一个坐在长椅上的少女。一个剪短发的年轻人。一个穿围裙的男人。一个老人。"
    n "它们飘着，靠近，几乎要重叠在一起——"
    n "可一晃，又散开了。"

    mono "（那些影子……)"
    mono "（我眯起眼，想看清它们。)"
    mono "（它们好像……是同一个轮廓。)"
    mono "（可每当我快要抓住那个念头，它就滑走了。)"
    mono "（像是一个我快要想起、却还没想起的梦。)"

    # ============================================================
    # 1963：他遇见了她
    # ============================================================
    scene bg park_spring
    with slow_dissolve

    n "1963年。四月。公园。"
    n "樱花开着。阳光碎成一地金子。"

    n "约翰从白光里走出来，站在公园门口。"
    n "他还穿着1970年的旧夹克，像个闯入彩色照片的黑白影子。"

    n "然后，他看见了她。"

    show jane neutral at char_center
    with dissolve

    n "长椅上，坐着一个少女。"
    n "膝盖上摊着一本书，但她没在看。"
    n "她在看人来人往。"

    n "约翰愣住了。"
    n "这张脸。"
    n "他认识这张脸。"
    n "他在镜子里见过。在很多年前的镜子里。"
    n "可那怎么可能……"

    john "（不……)"
    john "（这张脸……我……)"
    john "（为什么，我的心跳得这么快？)"
    john "（为什么，我觉得我认识她。认识得……比认识任何人都深？)"

    mono "（他的腿，不听使唤地，走了过去。)"
    mono "（他不知道自己要做什么。)"
    mono "（他张开嘴，话，自己冒了出来——)"

    stranger "你在看人。"

    n "约翰听见自己说出了这句话。"
    n "然后，一阵寒意，从他的脊背爬了上来。"
    n "这句话……他听过。"
    n "有人，对他说过这句话。一字不差。"
    n "是什么时候？是谁？……他想不起来。它就像在舌尖上，却怎么也抓不住。"

    jane "……什么？"
    stranger "你坐在这儿，看人来人往。你在想——没有一个人是为我而来的。"

    n "少女的书，从膝盖上滑下去了。"
    n "约翰看着她的眼睛——那双灰绿色的、冬天湖面一样的眼睛。"
    n "有那么一瞬间，他觉得，自己什么都明白了。"
    n "可那个「明白」，像水里的倒影。他一伸手，就碎了。"

    john "（我懂她。)"
    john "（我懂她说的每一个字，和每一个没说出口的字。)"
    john "（这世上，再没有第二个人，能像我这样懂她。)"
    john "（……为什么？为什么，我会这样懂她？)"

    mono "（他爱上了她。)"
    mono "（他怎么能不爱她。)"
    mono "（和她在一起，他这辈子，第一次觉得「完整」。)"
    mono "（好像他弄丢了很久的什么东西，终于，又回到了他手里。)"

    n "樱花落下来。"
    n "他吻了她。"
    n "就像……很久以前，有人这样吻过他。"
    n "这个念头一闪。他抓不住。他也不想抓。"

    mono "（有什么东西，咔哒一声，合上了。)"
    mono "（可他不知道，那是什么。)"

    # ============================================================
    # 1945：婴儿回家
    # ============================================================
    scene bg time_vortex
    with dissolve

    n "而与此同时——"
    n "在时间漩涡的另一端，我抱着一个襁褓。"

    mono "（这是我的部分。)"
    mono "（我一直知道，总有一天，会轮到我来做这件事。)"
    mono "（只是我不知道……为什么，我会这么笃定。)"

    scene bg orphanage_ext
    with slow_dissolve

    n "1945年。克利夫兰。冬天。"
    n "雪下得很大。一家孤儿院的铁门，锈迹斑斑。"

    n "我站在门外，怀里是一个女婴。"
    n "她睡着了。左眉尾，有一道极细的胎记。"

    scene cg baby_returned
    with dissolve

    n "我弯下腰，把她轻轻放在台阶上。"
    n "雪落在她的襁褓上。"

    mono "（对不起。)"
    mono "（也……谢谢你。)"
    mono "（我必须，把你放在这里。)"
    mono "（我不知道为什么。我只是知道——我必须。)"
    mono "（好像只有这样，一切才能……开始。)"
    mono "（我弯下腰，把她，轻轻放下。)"
    mono "（心口，闷闷地疼。)"

    n "门里传来脚步声。修女要出来了。"
    n "我退进雪里，退进风里，退进时间的褶皱里。"

    n "身后，传来一声婴儿的啼哭。"
    n "嘹亮得像，一个世界的开端。"

    mono "（又有什么东西，咔哒一声，合上了。)"
    mono "（我还是不知道，那是什么。)"

    # ============================================================
    # 1985：交棒
    # ============================================================
    scene bg bureau_office
    with dissolve

    n "1985年。一间灰色的办公室。"
    n "约翰坐在我对面。"
    n "从公园回来以后，他就一直是这个样子——魂不守舍，像是被什么东西，从里面掏空了。"

    john "那个公园里的姑娘……"
    n "他盯着自己的手，看了很久。"
    john "我认识她。我他妈的，太认识她了。"
    john "我懂她，懂到……害怕。"
    n "他抬起头，眼睛是红的。"
    john "酒保。我是不是……对她做了什么，很可怕的事？"

    mono "（我张了张嘴。)"
    mono "（答案，就在我嘴边。)"
    mono "（可它还没有成形。它还差……最后一块。)"

    bureau "时间局需要你这样……「完整」的人。"
    bureau "没有过去可以被威胁。没有亲人可以被挟持。"
    bureau "你，就是你自己的全部。"

    john "……完整。"
    n "他咀嚼着这个词，像是觉得它又对，又荒谬。"
    john "……好。我加入。"

    n "他站起来，走到门口，停下，回头看我。"
    john "酒保。"
    john "你知道些什么，对不对？"
    john "关于我。关于她。关于……这一切。"

    menu:
        bart "……"

        "「你会明白的。等你准备好的时候。」":
            $ acceptance += 2
            john "……"
            n "他点点头，像是接受了一个他还不懂的答案。"
            john "好。我等。"

        "「我……也还在弄明白。」":
            $ bewilderment += 2
            john "连你也不知道？"
            n "他苦笑了一下。"
            john "哈。原来我们，都在雾里。"

        "「对不起。」":
            $ resentment += 1
            $ acceptance += 1
            john "别道歉。"
            n "他摆摆手。"
            john "你和我一样。都在做……不得不做的事。"

    n "他推门出去，走进1985年的光里。"
    n "去成为，他注定要成为的人。"
    n "而我，还差最后一步，才能看清，那个「注定」，到底是什么。"

    # ============================================================
    # 1970：回到酒吧
    # ============================================================
    scene bg bar_main
    with fade

    n "我回来了。"
    n "1970年。酒吧。凌晨三点四十分。"
    n "雨还在下。钟还在走。"
    n "吧台上，那只杯子还在原处，杯底剩着一圈琥珀色的光。"

    n "一切都和我离开时，一模一样。"
    n "仿佛什么都没有发生过。"

    mono "（可有什么东西，不一样了。)"
    mono "（这一晚，我见过的一切——)"
    mono "（雪里的婴儿。长椅上的少女。公园里的他。手术台上的她。写故事的他。舱里的他。1985年的他。)"
    mono "（它们在我脑子里，转啊，转啊。)"
    mono "（像那条漩涡里的蛇。)"
    mono "（那个我一直不敢去看的东西……)"
    mono "（现在，我躲不掉了。)"

    # ============================================================
    # 揭示：真相
    # ============================================================

    n "我走到镜子前面。"
    n "镜子里，是我。"
    n "我盯着那双灰绿色的眼睛。盯了很久，很久。"

    mono "（那双眼睛。)"
    mono "（我在婴儿的脸上，见过。)"
    mono "（我在少女的脸上，见过。)"
    mono "（我在他的脸上，见过。)"
    mono "（我在……镜子里，天天都见。)"

    n "我的心，开始狂跳。"
    n "那个我一直不敢去看的念头，那个一伸手就碎掉的「明白」——"
    n "这一次，我没有再让它逃走。"
    n "我伸出手，一把，抓住了它。"

    mono "（婴儿。)"
    mono "（那个被放在雪地里的婴儿——)"

    n "我对着镜子，说出了声。声音抖得不成样子。"

    bart "婴儿……是你。"

    mono "（少女。)"
    mono "（那个坐在长椅上，看人来人往的少女——)"

    bart "简……是你。"

    mono "（那个男人。)"
    mono "（那个在公园里，吻了她，又抛弃了她的人——)"

    bart "那个男人……也是你。"

    n "我的声音，越来越大。"

    bart "你的母亲，是你。你的父亲，是你。"
    bart "你爱的那个人，是你。"
    bart "你生下的那个孩子——"
    bart "还是你。"

    n "镜子里的我，眼泪流了下来。"
    n "可我在笑。"

    bart "一整支军队。"
    bart "你他妈的……就是你自己的一整支军队。"

    n "然后，我看向镜子里，那个穿着围裙的我。"
    n "那个，从一开始，就站在吧台后面，听他讲故事的我。"

    mono "（还有我。)"
    mono "（那个酒保。)"
    mono "（那个，从第一眼起，就觉得「我认识他」的我。)"
    mono "（那个，心口一直闷闷地疼的我。)"

    bart "而我……"
    n "我把手，贴在冰冷的镜面上。"
    bart "也是我。"
    bart "是你。"
    bart "是，很多很多年以后的，你。"

    n "镜子里，镜子里外，所有的「我」，都在看着彼此。"
    n "婴儿。少女。他。我。老人。"
    n "是同一个人。"
    n "从头到尾，从生到死，从开始，到开始——"
    n "只有一个人。"

    mono "（现在，你知道了。)"
    mono "（那个婴儿是谁。那个少女是谁。那个男人是谁。)"
    mono "（还有——我是谁。)"
    mono "（其实，你早就该猜到的。)"
    mono "（因为，从你走进这家酒吧的第一眼起——)"
    mono "（你就一直在，照镜子。)"

    n "酒吧里，安静极了。"
    n "只有雨。只有钟。"
    n "还有我，一个人，站在一屋子的「自己」中间。"

    jump ending_hub
