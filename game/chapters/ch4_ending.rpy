# 终章：衔尾蛇 - ch4_ending.rpy
# 酒保独白。根据三轴情感系统判定4种结局。

label ending_hub:

    scene bg bar_main
    with fade
    play music "audio/bgm/ending_base.wav"

    n "我给自己倒了一杯酒。"
    n "这是我今晚，第一次为自己倒酒。"

    n "我端起杯子，走到窗边。"
    n "雨小了一些。霓虹灯的红，在湿漉漉的街面上晕开。"

    mono "（现在，只剩下我了。)"
    mono "（只剩下「我」，和这个「我」。)"

    # ----- 判定结局 -----
    $ ending_type = determine_ending()

    if ending_type == "epiphany":
        jump ending_epiphany
    elif ending_type == "rage":
        jump ending_rage
    elif ending_type == "peace":
        jump ending_peace
    else:
        jump ending_vertigo


# ============================================================
# 结局一：愤恨版 (rage)
# 主导情感：resentment
# ============================================================
label ending_rage:

    play music "audio/bgm/ending_rage.wav"

    n "我看着杯子里的酒。"
    n "琥珀色的液体，晃啊晃，像一个小小的、旋转的牢笼。"

    mono "（一个环。)"
    mono "（一个该死的、完美的、密不透风的环。)"

    n "我忽然觉得恶心。"
    n "我把杯子，狠狠砸在吧台上。"
    n "玻璃碎了。酒溅出来，在木头台面上漫开，像一滩血。"

    mono "（凭什么？)"
    mono "（凭什么，我要把我自己，一次又一次地——)"
    mono "（遗弃在雪地里。抛弃在长椅上。剖开在手术台上。)"
    mono "（凭什么，我的母亲是我，我的爱人是我，我的刽子手，也是我？)"

    n "我抓起酒瓶，想再砸一个。"
    n "可是手举到一半，停住了。"

    mono "（砸了，又怎么样呢？)"
    mono "（我恨的这个「命运」——)"
    mono "（就是我。)"
    mono "（我恨的每一寸，都是我自己的血肉。)"
    mono "（我就算把自己烧成灰——)"
    mono "（灰里，也还是会长出这条蛇。)"

    n "我站在一片狼藉里，喘着气。"
    n "然后，我慢慢地，慢慢地，蹲下去，开始捡那些碎玻璃。"

    mono "（我恨你。)"
    mono "（我恨你，恨得……)"
    mono "（只能继续爱你。)"
    mono "（因为我，只有你。)"

    n "天快亮了。"
    n "雨，终于停了。"

    jump credits


# ============================================================
# 结局二：释然版 (peace)
# 主导情感：acceptance
# ============================================================
label ending_peace:

    play music "audio/bgm/ending_peace.wav"

    n "我端着酒杯，回到吧台后面。"
    n "我把那只擦了一半的杯子，重新拿起来，慢慢地，擦完了。"

    mono "（一个环。)"
    mono "（是啊。一个环。)"
    mono "（可是你知道吗——)"
    mono "（环，也是「圆」啊。)"

    n "我笑了。"
    n "这是我今晚，第一次，真正地笑。"

    mono "（我遗弃了我自己。)"
    mono "（所以，我给了我自己，一个开始。)"
    mono "（我抛弃了我自己。)"
    mono "（所以，我教会了我自己，什么是爱，什么是痛。)"
    mono "（我剖开了我自己。)"
    mono "（所以，我让我自己，活了下来。)"

    n "我把酒杯举起来，对着空无一人的酒吧，轻轻碰了一下。"
    n "像，和自己干杯。"

    mono "（别人的一生，是一条线。)"
    mono "（从别人来，到别人去。)"
    mono "（我的一生，是一个圆。)"
    mono "（从我来，到我回。)"
    mono "（我没有家。)"
    mono "（可是，我就是我自己的家。)"

    n "窗外的天，泛起一点灰白。"
    n "雨停了。"
    n "我哼起一支不成调的曲子，开始擦第二只杯子。"

    mono "（晚安，简。)"
    mono "（晚安，约翰。)"
    mono "（晚安，我。)"
    mono "（我们，明天见。)"

    jump credits


# ============================================================
# 结局三：困惑版 (vertigo)
# 主导情感：bewilderment
# ============================================================
label ending_vertigo:

    play music "audio/bgm/ending_vertigo.wav"

    n "我端着酒杯，站在吧台中间。"
    n "忽然，我觉得整个房间，轻轻地，转了一下。"

    mono "（一个环。)"
    mono "（可是……环的起点，在哪里？)"

    n "我走到镜子前面。"
    n "镜子里，是我。"
    n "可是有那么一瞬间，我看到的，不是「一个」我。"

    n "是那个雪里的婴儿。是长椅上的少女。是手术台上的她。"
    n "是公园里的他。是写故事的他。是舱里的他。是老人。"
    n "一层，一层，一层，叠在镜子里，全都看着我。"

    mono "（到底，哪一个，才是「第一个」？)"
    mono "（是先有了婴儿，才有了我？)"
    mono "（还是先有了我，才……放回了婴儿？)"
    mono "（鸡生蛋，蛋生鸡。)"
    mono "（可如果，鸡和蛋，是同一个东西呢？)"

    n "我伸出手，碰了碰镜子。"
    n "镜面冰凉。"

    mono "（我是谁？)"
    mono "（这个问题，别人用一生来问。)"
    mono "（而我，问出来的答案，是一个「所有人」。)"
    mono "（也等于，一个「没有人」。)"

    n "我转过头，看向空荡荡的酒吧，看向门外湿漉漉的、空无一人的街。"
    n "我忽然很想问一句——"

    mono "（我知道，我从哪里来。)"
    mono "（我从我自己来。)"
    mono "（可是——)"
    mono "（你们呢？)"
    mono "（你们这些，有爸爸、有妈妈、有来处的「人」——)"
    mono "（你们这些……僵尸。)"
    mono "（你们，又是从哪里来的？)"

    n "没有人回答我。"
    n "只有雨，又开始下了。"

    jump credits


# ============================================================
# 结局四：顿悟版 (epiphany) - 隐藏结局
# 三轴均 >= 12：既愤怒，又接纳，又眩晕，最终归于"我即是环"
# ============================================================
label ending_epiphany:

    play music "audio/bgm/ending_epiphany.wav"

    n "我端着酒杯，站在吧台后面。"
    n "奇怪的是，我的心里，同时翻涌着三种东西。"

    mono "（我恨这个环。恨得想把一切都砸碎。)"
    mono "（我爱这个环。爱得想把它抱进怀里。)"
    mono "（我怕这个环。怕得连「我」是谁，都不敢确定。)"

    n "恨，爱，怕。"
    n "它们在我身体里，打了很久，很久。"
    n "然后，忽然之间——"
    n "它们，安静了。"

    n "不是消失了。"
    n "是它们终于明白，它们，也是同一个东西。"

    scene cg ouroboros_light
    with dissolve

    mono "（蛇，咬住了自己的尾巴。)"
    mono "（人们说，那是囚笼。)"
    mono "（可是你看——)"
    mono "（当蛇，心甘情愿地，咬住自己的那一刻——)"
    mono "（囚笼，就变成了光环。)"

    n "我看见了。"
    n "在酒杯晃动的光里，我看见了「我们」。"
    n "婴儿，少女，他，我，老人。"
    n "我们站成一个圈，手拉着手。"
    n "每一张脸上，都有泪。"
    n "可是每一张脸上，也都在笑。"

    mono "（我不是被困在环里的人。)"
    mono "（我，就是环本身。)"
    mono "（我不是在重复我的一生。)"
    mono "（我的一生，就是「重复」本身。)"
    mono "（而这，不是诅咒。)"
    mono "（这是……圆满。)"

    n "我举起酒杯。"
    n "这一次，我不是和自己干杯。"
    n "我是和「我们」，所有人，干杯。"

    bart "敬，我自己。"
    bart "敬，你们，所有的我。"
    bart "敬，这条，首尾相衔的——"
    bart "完美的蛇。"

    n "我把酒，一饮而尽。"

    mono "（可是，故事还没有结束。)"
    mono "（我的故事，从来，就没有结束过。)"
    mono "（还有最后一段路。)"
    mono "（那段，我最不愿走，却终究要走完的路。)"

    # ============================================================
    # 1993：未来线（隐藏结局专属）
    # 调色：暖灰 + 暮色金，疲惫的平静
    # ============================================================
    scene bg room_1993
    with fade
    play music "audio/bgm/room_1993.wav"

    n "1993年。"
    n "一间不大的房间。窗外，是暮色。"
    n "金色的、疲惫的光，落在旧地板上。"

    n "我老了。"
    n "今天，我做完了最后一件事——"
    n "把那个年轻人，招进了时间局。"
    n "把「我」，交给了「我」。"
    n "现在，这条蛇，真正地，咬住了它的尾巴。"

    n "我站在床边，开始换衣服。"
    n "解开衬衫的扣子。一颗。又一颗。"

    scene cg scar
    with dissolve

    n "然后，我又看见了它。"
    n "肚子上，那道疤。"
    n "剖腹产留下的。"
    n "几十年了，它还在那里。"
    n "像一张，永远不会愈合的嘴。"

    n "我用手指，轻轻地，摸了摸它。"

    mono "（这是「她」留给我的。)"
    mono "（简，留给我最后的，一样东西。)"

    n "我坐下来。暮色，越来越深。"
    n "我望着窗外，望着这个，我自己一个人，活了一辈子的世界。"
    n "忽然，我想说点什么。"
    n "对着这间空屋子。对着暮色。对着……所有不在这里的人。"

    bart "蛇，吞吃了它自己的尾巴。"
    bart "一圈，又一圈。"
    bart "周而复始。"
    bart "……何谓始？何谓终？"

    n "我笑了一下。"

    bart "我终于知道，我是从哪里来的了。"
    bart "我从，我自己来。"
    bart "可是你们呢？"
    n "我抬起头，望向那片越来越暗的天。"
    bart "你们这些……回魂尸。"
    bart "你们，又是从哪里来的呢？"

    n "没有人回答。"
    n "从来，就没有人回答。"

    n "太阳穴，忽然一阵刺痛。"
    n "又来了。"

    mono "（抽屉里，有头痛药粉。)"
    mono "（但我没有去拿。)"
    mono "（我从来，不吃那东西。)"

    n "我掀开被子，钻了进去。"
    n "床很凉。"
    n "我吹了一声口哨。"

    n "灯，灭了。"

    scene black
    with slow_fade

    n "……"

    n "黑暗里，什么都没有。"

    n "你，根本就不在那里。"
    n "从来，都不在。"

    n "这里没有别人。"
    n "只有我。"

    n "是简。"
    n "孤零零地，待在这片黑暗里。"

    n "……我，真想你。"

    jump credits


# ============================================================
# 制作名单
# ============================================================
label credits:

    scene black
    with fade

    n "《你们这些还魂尸》"
    n "—— 一部基于罗伯特·海因莱因同名小说的原创同人改编视觉小说 ——"
    n "非商业作品，谨向原作致敬。"

    # 线索彩蛋：集齐7条线索解锁
    if clue_count >= 7:
        scene cg all_forms
        with dissolve
        n "【彩蛋】你集齐了全部七条线索。"
        n "现在你知道了——从第一眼起，你就认出了他。"
        n "因为，你一直都在照镜子。"

    return
