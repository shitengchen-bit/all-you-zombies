# 序章：打烊之前 - ch0_prologue.rpy
# 时代调色：1970酒吧，深褐+病态橄榄绿+昏黄，凌晨三点的绝望

label prologue:

    # ----- 场景建立 -----
    scene bg bar_main
    with fade
    play music "audio/bgm/bar_main.wav" fadein 3.0
    play sound "audio/sfx/rain.wav" loop

    n "雨从傍晚下到现在，还没有要停的意思。"
    n "霓虹灯的光穿过雨幕，在吧台上投下一道道湿漉漉的红。"
    n "墙上的钟指向凌晨两点四十分。"

    mono "（又是这样一个夜晚。)"
    mono "（我擦着同一只杯子，已经擦了二十分钟。杯子早就干净了，我只是需要一件事来做。)"

    n "这家酒吧叫「Pop's Place」。名字很土，灯光很暗，酒很烈。"
    n "来这儿的人，多半不是为了喝酒。"

    mono "（他们是为了找一个愿意听他们说话的人。)"
    mono "（而我，恰好是个最会听故事的人。)"
    mono "（……说来奇怪。)"
    mono "（我总觉得，我好像听过这个故事。很久很久以前，就听过。)"
    mono "（可这怎么可能呢。今晚，才是我第一次见到他。)"

    # ----- 客人进入 -----
    n "门被推开时，铃铛响了一声，闷闷的，像是不情愿。"
    n "进来的是一个年轻男人。"

    scene bg bar_main
    show john neutral at char_right
    with dissolve

    n "他大概二十五六岁，瘦削，穿着一件旧得发白的男士衬衫，外面套着夹克。"
    n "头发剪得很短。他在门口站了一会儿，像是在确认这里还有没有别人。"
    n "然后他走到吧台前，坐下。"

    n "他没有立刻说话。他只是坐着，盯着吧台上一道划痕，仿佛那道划痕里藏着什么答案。"

    # ----- 第一处线索：灰绿眼 -----
    mono "（我抬起头，准备问他喝什么。)"
    mono "（然后我看见了她的——他的眼睛。)"

    $ add_clue("clue_eyes")

    mono "（灰绿色的。)"
    mono "（很淡，像冬天结了薄冰的湖面。)"
    mono "（……我在哪里见过这样的眼睛。)"
    mono "（不。不是「见过」。)"
    mono "（是「太熟悉了」。熟悉得让我握着杯子的手顿了一下。)"

    # ----- 第一次选择：如何打量客人 -----
    menu:
        bart "……"

        "（又一个被生活打败的人。)":
            $ resentment += 1
            mono "（又一个被生活打败的人。这座城市里多的是。)"
            mono "（他会在天亮前喝醉，讲一些没人想听的事，然后消失。)"

        "（他的眼睛……让我想起某个人。)":
            $ bewilderment += 2
            mono "（他的眼睛……让我想起某个人。)"
            mono "（一个我以为再也不会见到的人。)"
            mono "（可这怎么可能呢。)"

        "（今晚，我会好好听他说。)":
            $ acceptance += 1
            mono "（今晚，我会好好听他说。)"
            mono "（不知道为什么，我觉得我应该听。)"
            mono "（就好像……我等这一晚，已经等了很久。)"

    # ----- 点酒 -----
    john "威士忌。"
    n "他的声音很低，有点哑，像是很久没跟人说过话了。"
    john "纯的。别加那些乱七八糟的。"

    bart "好。"

    n "我倒了一杯，推过去。"
    n "他端起来，没有马上喝。他用两只手捧着杯子，像是在取暖。"

    # ----- 第三处线索铺垫：握杯姿势（此处先埋，T2正式触发）-----
    mono "（他握杯子的方式有点奇怪。)"
    mono "（小指微微翘着，手腕很柔。不像一个男人该有的姿势。)"
    mono "（倒像是……一个习惯了端茶杯的女人。)"

    n "他喝了一口，皱了皱眉，又喝了一口。"
    n "然后他抬起头，看着我。那双灰绿色的眼睛里，有一种我很熟悉的东西。"

    john "你不像别的酒保。"
    bart "哦？"
    john "别的酒保会问『今天过得怎么样』之类的废话。你不问。"

    menu:
        bart "……"

        "「我看你不想被问那种问题。」":
            $ trust += 2
            $ acceptance += 1
            john "……"
            n "他愣了一下，然后笑了。那笑容很短，像是脸上的肌肉已经忘记了怎么笑。"
            john "是啊。我不想。"

        "「我只是在等你自己开口。」":
            $ trust += 1
            $ bewilderment += 1
            john "等我开口？"
            n "他眯起眼睛，像是在打量我。"
            john "你倒是自信。你怎么知道我会开口？"

        "「干我们这行的，听得比说得多。」":
            $ trust += 1
            john "哼。"
            n "他又喝了一口。"
            john "也是。酒保嘛。半个牧师，半个垃圾桶。"

    # ----- 引出"未婚妈妈"身份 -----
    n "他从夹克口袋里掏出一叠皱巴巴的纸，放在吧台上。"
    n "我瞥了一眼。是手写的稿子，字迹很密。"

    # ----- 第四处线索铺垫：笔迹（T2酒吧正式触发，此处先埋）-----
    mono "（那字迹……)"
    mono "（我心头又是一跳。)"
    mono "（那字迹，和我自己的，几乎一模一样。)"
    mono "（一定是我看错了。这种巧合……太荒唐了。)"

    john "你看过《真话杂志》吗？"
    bart "偶尔翻翻。"
    john "上面有个专栏，叫『未婚妈妈』。专门登那些……私生子的母亲写的忏悔故事。"
    n "他扯了扯嘴角，那不算笑。"
    john "那些故事，都是我写的。"

    menu:
        bart "……"

        "「你是说，你假扮成女人写那些故事？」":
            $ bewilderment += 1
            john "假扮？"
            n "他的眼神突然变得很锋利。"
            john "我不用假扮。我比那些女人更懂她们写的每一个字。"
            john "因为那些事……我都经历过。"

        "「那一定很赚钱。」":
            $ resentment += 1
            john "赚钱？"
            n "他冷笑了一声。"
            john "一个字半分钱。我写一个母亲怎样被男人抛弃、怎样独自生下孩子、怎样在深夜里哭——"
            john "——半分钱。"
            john "我把我的命，一个字半分钱地卖给他们。"

        "「你写得很好。」（真诚地）":
            $ trust += 2
            $ acceptance += 1
            n "他看着我，似乎想从我脸上找出嘲讽。但他没找到。"
            john "……你怎么知道写得好？你看过？"
            bart "我看过几篇。"
            bart "写那些故事的人，一定受过很深的伤。"
            n "他沉默了很久。久到我以为他不会回答了。"
            john "……是啊。"
            john "受过很深的伤。"

    # ----- 过渡到第一幕 -----
    n "他又喝了一大口。杯子快空了。"
    n "雨还在下。钟指向三点。"
    n "我知道，他快要说了。那些他憋了很久、没人可说的话。"

    mono "（说吧。)"
    mono "（告诉我，你是怎么变成现在这个样子的。)"
    mono "（告诉我……这一切，到底是从哪里开始的。)"

    john "你真的很想听？"
    john "我这一生，说出来都没人信。"

    menu:
        bart "……"

        "「我什么都听过。说出来吧。」":
            $ trust += 1
            john "哈。"
            n "他把空杯子推向我。"
            john "再来一杯。然后我告诉你。"
            john "从头开始。从那个该死的孤儿院开始。"

        "「我有的是时间。」":
            $ acceptance += 1
            n "我拿起酒瓶，给他续上。"
            john "……行。"
            n "他深吸一口气，像是在跳进什么冰冷的东西里。"
            john "那就从1945年说起吧。"

    n "我又给他倒了一杯。"
    n "他端着杯子，目光越过我，看向某个很远的地方。"
    n "某个回不去的地方。"

    john "1945年。克利夫兰。一家孤儿院。"
    john "那年我……不。那年「她」，刚出生。"

    n "他用了「她」这个字。"
    n "他说得很轻，很怪，像是在说一个陌生人。"
    n "又像是在说一个，再也回不去的自己。"

    # ----- 进入第一幕：话题选择枢纽 -----
    jump act1_hub
